@model List<FreshStart.Models.Application.JobApplication>

@{
    ViewData["Title"] = "My Applications";
}


<div class="container mt-5">


    <h1 class="mb-4">
        My Applications
    </h1>



    @if (Model.Count == 0)
    {

        <div class="alert alert-info">

            You have not applied for any jobs yet.

        </div>

    }
    else
    {


        @foreach (var application in Model)
        {

            <div class="card shadow p-4 mb-4">


                <div class="d-flex justify-content-between align-items-center">


                    <h3>
                        @application.Job.JobTitle
                    </h3>



                    @if (application.Status == "Rejected")
                    {
                        <span class="badge bg-danger p-2">
                            Rejected
                        </span>
                    }
                    else if (application.Status == "Selected")
                    {
                        <span class="badge bg-success p-2">
                            Selected
                        </span>
                    }
                    else if (application.Status == "Interview Scheduled")
                    {
                        <span class="badge bg-info p-2">
                            Interview Scheduled
                        </span>
                    }
                    else if (application.Status == "Shortlisted")
                    {
                        <span class="badge bg-primary p-2">
                            Shortlisted
                        </span>
                    }
                    else if (application.Status == "Reviewed")
                    {
                        <span class="badge bg-secondary p-2">
                            Reviewed
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning p-2">
                            Pending
                        </span>
                    }


                </div>


                <hr />



                <p>
                    <strong>Company:</strong>

                    @application.Job.Employer.CompanyName
                </p>



                <p>
                    <strong>Location:</strong>

                    @application.Job.Location
                </p>



                <p>
                    <strong>Salary:</strong>

                    @application.Job.Salary
                </p>



                <p>
                    <strong>Job Type:</strong>

                    @application.Job.JobType
                </p>



                <p>
                    <strong>Applied Date:</strong>

                    @application.AppliedDate.ToShortDateString()
                </p>



                @if (application.Status == "Interview Scheduled")
                {

                    <hr />

                    <div class="card bg-light p-3">


                        <h5>
                            Interview Details
                        </h5>


                        <p>
                            <strong>Date:</strong>

                            @application.InterviewDate?.ToShortDateString()
                        </p>


                        <p>
                            <strong>Time:</strong>

                            @application.InterviewTime
                        </p>


                        <p>
                            <strong>Location:</strong>

                            @application.InterviewLocation
                        </p>


                    </div>

                }



                @if (!string.IsNullOrEmpty(application.EmployerNotes))
                {

                    <hr />

                    <p>
                        <strong>Employer Note:</strong>

                        @application.EmployerNotes
                    </p>

                }



            </div>

        }


    }



</div>