@model FreshStart.Models.Job.Job

@{
    ViewData["Title"] = "Job Details";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .job-details-page {
        background: #f4f7fc;
        min-height: 100vh;
        padding: 32px 0;
    }

    .details-sidebar,
    .details-card,
    .info-card {
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 18px;
        box-shadow: 0 5px 22px rgba(31, 55, 90, 0.06);
    }

    .details-sidebar {
        padding: 24px 18px;
        position: sticky;
        top: 20px;
    }

    .brand-name {
        color: #1769e0;
        font-size: 27px;
        font-weight: 800;
        letter-spacing: -0.7px;
    }

    .sidebar-label {
        color: #98a2b3;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.2px;
        margin: 25px 12px 12px;
        text-transform: uppercase;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #58677e;
        text-decoration: none;
        padding: 13px 14px;
        margin-bottom: 7px;
        border-radius: 11px;
        font-weight: 500;
        transition: all 0.2s ease;
    }

        .sidebar-link i {
            font-size: 18px;
        }

        .sidebar-link:hover {
            background: #f0f5ff;
            color: #1769e0;
        }

        .sidebar-link.active {
            background: #1769e0;
            color: #fff;
            box-shadow: 0 5px 12px rgba(23, 105, 224, 0.2);
        }

    .details-card {
        padding: 34px;
    }

    .job-icon {
        width: 66px;
        height: 66px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf2ff;
        color: #1769e0;
        font-size: 29px;
        border-radius: 17px;
        flex-shrink: 0;
    }

    .job-title {
        color: #172b4d;
        font-size: 32px;
        font-weight: 800;
        letter-spacing: -0.7px;
        overflow-wrap: anywhere;
    }

    .company-name {
        color: #78869a;
        font-size: 15px;
    }

    .job-type-badge {
        display: inline-block;
        background: #edf4ff;
        color: #1769e0;
        padding: 9px 14px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
    }

    .section-heading {
        color: #172b4d;
        font-size: 19px;
        font-weight: 750;
        margin-bottom: 15px;
    }

    .description-text {
        color: #65738a;
        font-size: 15px;
        line-height: 1.9;
        overflow-wrap: anywhere;
        white-space: pre-line;
    }

    .info-card {
        padding: 21px;
        height: 100%;
        background: #f8faff;
        box-shadow: none;
        border-radius: 14px;
    }

    .info-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf2ff;
        color: #1769e0;
        border-radius: 12px;
        font-size: 20px;
        margin-bottom: 15px;
    }

    .info-label {
        color: #78869a;
        font-size: 13px;
        margin-bottom: 7px;
    }

    .info-value {
        color: #172b4d;
        font-size: 15px;
        font-weight: 700;
        overflow-wrap: anywhere;
        white-space: pre-line;
    }

    .salary-value {
        color: #1769e0;
        font-size: 19px;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .action-section {
        border-top: 1px solid #e8edf5;
        margin-top: 30px;
        padding-top: 25px;
    }

    .btn-apply,
    .btn-save,
    .btn-back {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 9px;
        border-radius: 10px;
        padding: 13px 20px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-apply {
        color: #fff;
        background: #1769e0;
        border: 1px solid #1769e0;
    }

        .btn-apply:hover {
            background: #1056bd;
            border-color: #1056bd;
            color: #fff;
            transform: translateY(-1px);
        }

    .btn-save {
        color: #1769e0;
        background: #edf4ff;
        border: 1px solid #d8e7ff;
    }

        .btn-save:hover {
            color: #1056bd;
            background: #dfeaff;
        }

    .btn-back {
        color: #58677e;
        background: #fff;
        border: 1px solid #dfe6f0;
    }

        .btn-back:hover {
            color: #1769e0;
            background: #f8faff;
        }

    @@media (max-width: 767px) {
        .job-details-page {
            padding: 20px 0;
        }

        .details-sidebar {
            position: static;
            margin-bottom: 24px;
        }

        .details-card {
            padding: 21px;
        }

        .job-title {
            font-size: 25px;
        }

        .job-header {
            align-items: flex-start !important;
        }

        .job-header-content {
            flex-wrap: wrap;
        }

        .action-buttons {
            display: flex;
            flex-direction: column;
        }

            .action-buttons form,
            .action-buttons a,
            .action-buttons button {
                width: 100%;
                margin-left: 0 !important;
            }
    }
</style>

<div class="job-details-page">
    <div class="container-fluid px-3 px-lg-4">
        <div class="row g-4">

            <!-- Sidebar -->
            <div class="col-lg-3 col-xl-2">
                <div class="details-sidebar">

                    <div class="brand-name">
                        <i class="bi bi-briefcase-fill me-2"></i>FreshStart
                    </div>

                    <div class="sidebar-label">Student Menu</div>

                    <a asp-controller="Student"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-grid-1x2"></i>
                        Dashboard
                    </a>

                    <a asp-controller="Student"
                       asp-action="Jobs"
                       class="sidebar-link active">
                        <i class="bi bi-search"></i>
                        Browse Jobs
                    </a>

                    <a asp-controller="Student"
                       asp-action="MyApplications"
                       class="sidebar-link">
                        <i class="bi bi-file-earmark-text"></i>
                        My Applications
                    </a>

                    <a asp-controller="Student"
                       asp-action="SavedJobs"
                       class="sidebar-link">
                        <i class="bi bi-bookmark"></i>
                        Saved Jobs
                    </a>

                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-9 col-xl-10">

                <!-- Breadcrumb -->
                <div class="mb-4">
                    <a asp-controller="Student"
                       asp-action="Jobs"
                       class="text-decoration-none"
                       style="color:#1769e0;">
                        <i class="bi bi-arrow-left me-2"></i>Back to Browse Jobs
                    </a>
                </div>

                <div class="details-card">

                    <!-- Job Header -->
                    <div class="d-flex justify-content-between align-items-center gap-4 job-header">
                        <div class="d-flex align-items-center gap-3 job-header-content">

                            <div class="job-icon">
                                <i class="bi bi-building"></i>
                            </div>

                            <div>
                                <h1 class="job-title mb-2">
                                    @Model.JobTitle
                                </h1>

                                <p class="company-name mb-0">
                                    <i class="bi bi-building me-2"></i>
                                    @(Model.Employer?.CompanyName ?? "Company")
                                </p>
                            </div>

                        </div>

                        <span class="job-type-badge">
                            <i class="bi bi-clock me-1"></i>
                            @Model.JobType
                        </span>
                    </div>

                    <hr class="my-4" />

                    <!-- Description -->
                    <section class="mb-4">
                        <h2 class="section-heading">
                            <i class="bi bi-file-text me-2" style="color:#1769e0;"></i>
                            Job Description
                        </h2>

                        <div class="description-text">
                            @Model.Description
                        </div>
                    </section>

                    <!-- Job Information -->
                    <section class="mt-5">
                        <h2 class="section-heading mb-3">Job Information</h2>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <div class="info-card">
                                    <div class="info-icon">
                                        <i class="bi bi-geo-alt"></i>
                                    </div>

                                    <div class="info-label">Location</div>

                                    <div class="info-value">
                                        @(string.IsNullOrWhiteSpace(Model.Location)
                                            ? "Not specified"
                                            : Model.Location)
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="info-card">
                                    <div class="info-icon">
                                        <i class="bi bi-wallet2"></i>
                                    </div>

                                    <div class="info-label">Salary Range</div>

                                    <div class="salary-value">
                                        ₨@Model.MinimumSalary.ToString("N0")
                                        – ₨@Model.MaximumSalary.ToString("N0")
                                    </div>

                                    <div class="info-label mt-2 mb-0">
                                        Per @(Model.SalaryType == "Monthly"
                                        ? "Month"
                                        : Model.SalaryType)
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="info-card">
                                    <div class="info-icon">
                                        <i class="bi bi-tools"></i>
                                    </div>

                                    <div class="info-label">Required Skills</div>

                                    <div class="info-value">
                                        @(string.IsNullOrWhiteSpace(Model.RequiredSkills)
                                            ? "Not specified"
                                            : Model.RequiredSkills)
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="info-card">
                                    <div class="info-icon">
                                        <i class="bi bi-calendar-event"></i>
                                    </div>

                                    <div class="info-label">Application Deadline</div>

                                    <div class="info-value">
                                        @Model.Deadline.ToShortDateString()
                                    </div>
                                </div>
                            </div>

                        </div>
                    </section>

                    <!-- Actions -->
                    <div class="action-section">

                        <h2 class="section-heading">Interested in this opportunity?</h2>

                        <p class="company-name mb-4">
                            Apply for this position or save it to review later.
                        </p>

                        <div class="d-flex flex-wrap gap-3 action-buttons">

                            <form asp-controller="Student"
                                  asp-action="ApplyJob"
                                  asp-route-id="@Model.JobId"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn-apply">
                                    <i class="bi bi-send"></i>
                                    Apply Now
                                </button>

                            </form>

                            <form asp-controller="Student"
                                  asp-action="SaveJob"
                                  asp-route-id="@Model.JobId"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn-save">
                                    <i class="bi bi-bookmark-plus"></i>
                                    Save Job
                                </button>

                            </form>

                            <a asp-controller="Student"
                               asp-action="Jobs"
                               class="btn-back">
                                <i class="bi bi-arrow-left"></i>
                                Back to Jobs
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        </div>
    </div>
</div>