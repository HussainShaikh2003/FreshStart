@model FreshStart.Models.Job.Job

@{
    ViewData["Title"] = "Job Details";
}


<div class="container-fluid mt-4">


    <div class="row">


        <!-- Sidebar -->

        <div class="col-md-3 mb-4">


            <div class="card shadow p-4">


                <h3 class="fw-bold text-primary">
                    FreshStart
                </h3>


                <hr />


                <a asp-controller="Student"
                   asp-action="Index"
                   class="btn btn-light text-start mb-2">

                    🏠 Dashboard

                </a>


                <a asp-controller="Student"
                   asp-action="Jobs"
                   class="btn btn-light text-start mb-2">

                    🔍 Browse Jobs

                </a>


                <a asp-controller="Student"
                   asp-action="MyApplications"
                   class="btn btn-light text-start mb-2">

                    📄 Applications

                </a>


                <a asp-controller="Student"
                   asp-action="SavedJobs"
                   class="btn btn-light text-start">

                    ⭐ Saved Jobs

                </a>


            </div>


        </div>


        <!-- Job Details -->

        <div class="col-md-9">


            <div class="card shadow p-5">


                <div class="d-flex justify-content-between align-items-center">


                    <div>


                        <h1 class="fw-bold">
                            @Model.JobTitle
                        </h1>


                        <h5 class="text-muted">
                            🏢 @Model.Employer?.CompanyName
                        </h5>


                    </div>


                    <div>

                        <span class="badge bg-primary p-3">

                            @Model.JobType

                        </span>

                    </div>


                </div>


                <hr />


                <h4>
                    Job Description
                </h4>


                <p class="text-muted">

                    @Model.Description

                </p>


                <div class="row mt-4">


                    <div class="col-md-6">


                        <div class="card bg-light p-3 mb-3">


                            <h5>
                                📍 Location
                            </h5>


                            <p>
                                @Model.Location
                            </p>


                        </div>


                        <div class="card bg-light p-3 mb-3">


                            <h5>
                                💰 Salary Range
                            </h5>


                            <p>
                                @Model.MinimumSalary.ToString("N0")
                                –
                                @Model.MaximumSalary.ToString("N0")
                                / @Model.SalaryType
                            </p>


                        </div>


                    </div>


                    <div class="col-md-6">


                        <div class="card bg-light p-3 mb-3">


                            <h5>
                                🛠 Skills
                            </h5>


                            <p>
                                @Model.RequiredSkills
                            </p>


                        </div>


                        <div class="card bg-light p-3 mb-3">


                            <h5>
                                📅 Deadline
                            </h5>


                            <p>
                                @Model.Deadline.ToShortDateString()
                            </p>


                        </div>


                    </div>


                </div>


                <hr />


                <div class="mt-3">


                    <form asp-controller="Student"
                          asp-action="ApplyJob"
                          asp-route-id="@Model.JobId"
                          method="post"
                          class="d-inline">


                        <button type="submit" class="btn btn-success btn-lg">

                            🚀 Apply Now

                        </button>


                    </form>


                    <form asp-controller="Student"
                          asp-action="SaveJob"
                          asp-route-id="@Model.JobId"
                          method="post"
                          class="d-inline ms-2">


                        <button type="submit" class="btn btn-warning btn-lg">

                            ⭐ Save Job

                        </button>


                    </form>


                    <a asp-controller="Student"
                       asp-action="Jobs"
                       class="btn btn-secondary btn-lg ms-2">

                        Back

                    </a>


                </div>


            </div>


        </div>


    </div>


</div>
