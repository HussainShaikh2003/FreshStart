@model FreshStart.Models.Student.StudentProfile

@{
    ViewData["Title"] = "Create Student Profile";
}


<div class="container-fluid mt-4">

    <div class="row">


        <!-- Sidebar -->

        <div class="col-md-3 mb-4">


            <div class="card shadow p-4">


                <h3 class="fw-bold text-primary">
                    FreshStart
                </h3>


                <hr />


                <a asp-controller="Student"
                   asp-action="Index"
                   class="btn btn-light text-start mb-2">

                    🏠 Dashboard

                </a>


                <a asp-controller="Student"
                   asp-action="Jobs"
                   class="btn btn-light text-start mb-2">

                    🔍 Browse Jobs

                </a>


                <a asp-controller="Student"
                   asp-action="MyApplications"
                   class="btn btn-light text-start mb-2">

                    📄 Applications

                </a>


                <a asp-controller="Student"
                   asp-action="SavedJobs"
                   class="btn btn-light text-start">

                    ⭐ Saved Jobs

                </a>


            </div>


        </div>





        <!-- Profile Form -->


        <div class="col-md-9">


            <div class="card shadow p-5">


                <h2 class="fw-bold text-center mb-4">
                    Create Your Profile 🚀
                </h2>



                <form asp-action="CreateProfile"
                      asp-controller="Student"
                      method="post"
                      enctype="multipart/form-data">


                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>



                    <div class="row">


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Full Name
                            </label>

                            <input asp-for="FullName"
                                   class="form-control"
                                   placeholder="Enter full name" />

                        </div>



                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Phone
                            </label>

                            <input asp-for="Phone"
                                   class="form-control"
                                   placeholder="03xx-xxxxxxx" />

                        </div>



                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                City
                            </label>

                            <input asp-for="City"
                                   class="form-control" />

                        </div>



                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                University
                            </label>

                            <input asp-for="University"
                                   class="form-control" />

                        </div>



                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Degree
                            </label>

                            <input asp-for="Degree"
                                   class="form-control" />

                        </div>



                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Graduation Year
                            </label>

                            <input asp-for="GraduationYear"
                                   class="form-control" />

                        </div>



                    </div>




                    <div class="mb-3">

                        <label class="form-label">
                            Skills
                        </label>

                        <input asp-for="Skills"
                               class="form-control"
                               placeholder="C#, ASP.NET, SQL" />

                    </div>




                    <div class="mb-3">

                        <label class="form-label">
                            Experience
                        </label>

<textarea asp-for="Experience"
          class="form-control"
          rows="4"></textarea>

                    </div>




                    <div class="mb-3">

                        <label class="form-label">
                            Professional Bio
                        </label>

<textarea asp-for="Bio"
          class="form-control"
          rows="4"></textarea>

                    </div>




                    <div class="row">


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                LinkedIn
                            </label>

                            <input asp-for="LinkedIn"
                                   class="form-control" />

                        </div>



                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                GitHub
                            </label>

                            <input asp-for="GitHub"
                                   class="form-control" />

                        </div>


                    </div>





                    <div class="mb-3">

                        <label class="form-label">
                            Upload Resume (PDF)
                        </label>

                        <input type="file"
                               name="ResumeFile"
                               class="form-control"
                               accept=".pdf" />

                    </div>




                    <div class="mb-3">

                        <label class="form-label">
                            Upload Profile Picture
                        </label>

                        <input type="file"
                               name="ProfileImageFile"
                               class="form-control"
                               accept="image/*" />

                    </div>





                    <button type="submit"
                            class="btn btn-primary w-100">

                        Save Profile

                    </button>



                </form>


            </div>


        </div>


    </div>


</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}