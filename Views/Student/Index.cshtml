@model FreshStart.Models.ViewModels.StudentDashboardViewModel

@{
    ViewData["Title"] = "Student Dashboard";
}


<div class="container-fluid mt-4">


    <div class="row">


        <!-- Sidebar -->

        <div class="col-md-3 mb-4">


            <div class="card shadow p-4">


                <h3 class="fw-bold text-primary">
                    FreshStart
                </h3>


                <hr />


                <a asp-controller="Student"
                   asp-action="Index"
                   class="btn btn-light text-start mb-2">

                    🏠 Dashboard

                </a>


                <a asp-controller="Student"
                   asp-action="EditProfile"
                   class="btn btn-light text-start mb-2">

                    👤 My Profile

                </a>


                <a asp-controller="Student"
                   asp-action="Jobs"
                   class="btn btn-light text-start mb-2">

                    🔍 Browse Jobs

                </a>


                <a asp-controller="Student"
                   asp-action="MyApplications"
                   class="btn btn-light text-start mb-2">

                    📄 Applications

                </a>


                <a asp-controller="Student"
                   asp-action="SavedJobs"
                   class="btn btn-light text-start mb-2">

                    ⭐ Saved Jobs

                </a>


                <a asp-controller="Notification"
                   asp-action="Index"
                   class="btn btn-light text-start">

                    🔔 Notifications

                </a>


            </div>


        </div>






        <!-- Main Dashboard -->


        <div class="col-md-9">



            <h1 class="fw-bold mb-4">
                Welcome to FreshStart 👋
            </h1>





            <!-- Stats Cards -->


            <div class="row mb-4">


                <div class="col-md-4">


                    <div class="card shadow text-center p-4">


                        <h5>
                            Profile Completion
                        </h5>


                        <h1 class="text-primary">
                            @Model.ProfileCompletion%
                        </h1>


                    </div>


                </div>





                <div class="col-md-4">


                    <div class="card shadow text-center p-4">


                        <h5>
                            Applications
                        </h5>


                        <h1 class="text-success">
                            @Model.TotalApplications
                        </h1>


                    </div>


                </div>





                <div class="col-md-4">


                    <div class="card shadow text-center p-4">


                        <h5>
                            Saved Jobs
                        </h5>


                        <h1 class="text-warning">
                            @Model.SavedJobs
                        </h1>


                    </div>


                </div>


            </div>






            @if (Model.Profile == null)
            {


                <div class="card shadow p-5 text-center">


                    <h2>
                        Complete Your Profile
                    </h2>


                    <p class="text-muted">
                        Create your profile to apply for jobs.
                    </p>



                    <a asp-controller="Student"
                       asp-action="CreateProfile"
                       class="btn btn-primary">

                        Create Profile

                    </a>



                </div>


            }

            else
            {


                <div class="card shadow p-4">



                    <div class="row align-items-center">



                        <div class="col-md-4 text-center">



                            @if (!string.IsNullOrEmpty(Model.Profile.ProfileImage))
                            {

                                <img src="@Model.Profile.ProfileImage"
                                     class="rounded-circle shadow"
                                     width="170"
                                     height="170" />

                            }
                            else
                            {

                                <div class="rounded-circle bg-secondary text-white p-5">

                                    No Image

                                </div>

                            }


                        </div>





                        <div class="col-md-8">


                            <div class="d-flex justify-content-between">


                                <h2 class="fw-bold">

                                    @Model.Profile.FullName

                                </h2>



                                <a asp-controller="Student"
                                   asp-action="EditProfile"
                                   class="btn btn-success">

                                    Edit

                                </a>


                            </div>



                            <hr />



                            <p>
                                🎓 <strong>University:</strong>
                                @Model.Profile.University
                            </p>



                            <p>
                                📚 <strong>Degree:</strong>
                                @Model.Profile.Degree
                            </p>



                            <p>
                                🛠 <strong>Skills:</strong>
                                @Model.Profile.Skills
                            </p>



                            <p>
                                💼 <strong>Experience:</strong>
                                @Model.Profile.Experience
                            </p>



                            <p>
                                About:
                                @Model.Profile.Bio
                            </p>





                            @if (!string.IsNullOrEmpty(Model.Profile.ResumePath))
                            {

                                <a href="@Model.Profile.ResumePath"
                                   target="_blank"
                                   class="btn btn-primary">

                                    View Resume

                                </a>

                            }



                        </div>



                    </div>


                </div>


            }



        </div>


    </div>


</div>