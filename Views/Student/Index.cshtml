@model FreshStart.Models.ViewModels.StudentDashboardViewModel

@{
    ViewData["Title"] = "Student Dashboard";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    :root {
        --fs-primary: #2563eb;
        --fs-primary-dark: #173b78;
        --fs-navy: #142b4a;
        --fs-bg: #f4f7fc;
        --fs-text: #26364b;
        --fs-muted: #718096;
        --fs-border: #e6ebf2;
    }

    body {
        background: var(--fs-bg);
    }

    .student-dashboard {
        color: var(--fs-text);
        padding: 28px 0 45px;
    }

        .student-dashboard a {
            text-decoration: none;
        }

    /* Sidebar */

    .student-sidebar {
        background: #fff;
        border: 1px solid var(--fs-border);
        border-radius: 18px;
        padding: 25px 17px;
        box-shadow: 0 5px 22px rgba(25, 50, 90, 0.04);
        position: sticky;
        top: 95px;
    }

    .sidebar-brand {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 0 10px 23px;
        border-bottom: 1px solid var(--fs-border);
        margin-bottom: 22px;
    }

    .brand-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: var(--fs-primary);
        border-radius: 13px;
        font-size: 21px;
    }

    .brand-name {
        color: var(--fs-navy);
        font-size: 21px;
        font-weight: 800;
        margin: 0;
        letter-spacing: -0.5px;
    }

    .sidebar-label {
        color: #9aa6b7;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.2px;
        padding: 0 12px;
        margin-bottom: 10px;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 13px;
        width: 100%;
        padding: 13px 14px;
        margin-bottom: 6px;
        border-radius: 11px;
        color: #637187;
        font-size: 14px;
        font-weight: 600;
        transition: all .2s ease;
    }

        .sidebar-link i {
            font-size: 18px;
            width: 21px;
            text-align: center;
        }

        .sidebar-link:hover,
        .sidebar-link.active {
            background: #edf4ff;
            color: var(--fs-primary);
        }

    .sidebar-help {
        background: #f1f6ff;
        border-radius: 13px;
        padding: 17px;
        margin-top: 27px;
    }

        .sidebar-help i {
            font-size: 23px;
            color: var(--fs-primary);
        }

        .sidebar-help h6 {
            margin: 12px 0 6px;
            color: var(--fs-navy);
            font-weight: 700;
        }

        .sidebar-help p {
            font-size: 12px;
            color: var(--fs-muted);
            margin-bottom: 12px;
            line-height: 1.6;
        }

        .sidebar-help a {
            font-size: 12px;
            font-weight: 700;
            color: var(--fs-primary);
        }

    /* Main content */

    .dashboard-heading {
        margin-bottom: 25px;
    }

        .dashboard-heading h1 {
            font-size: 28px;
            color: var(--fs-navy);
            font-weight: 800;
            letter-spacing: -0.8px;
            margin-bottom: 7px;
        }

        .dashboard-heading p {
            color: var(--fs-muted);
            margin: 0;
            font-size: 14px;
        }

    .dashboard-date {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        background: #fff;
        border: 1px solid var(--fs-border);
        border-radius: 10px;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
    }

    /* Welcome banner */

    .welcome-banner {
        background: linear-gradient(120deg, #173b78 0%, #2563eb 100%);
        color: #fff;
        border-radius: 18px;
        padding: 30px;
        position: relative;
        overflow: hidden;
        margin-bottom: 25px;
        box-shadow: 0 9px 24px rgba(37, 99, 235, .15);
    }

        .welcome-banner::after {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            border: 35px solid rgba(255,255,255,.07);
            border-radius: 50%;
            right: -45px;
            top: -100px;
            pointer-events: none;
        }

        .welcome-banner h2 {
            font-size: 24px;
            font-weight: 800;
            margin-bottom: 10px;
            position: relative;
            z-index: 1;
        }

        .welcome-banner p {
            font-size: 14px;
            line-height: 1.7;
            color: rgba(255,255,255,.82);
            max-width: 520px;
            margin-bottom: 20px;
            position: relative;
            z-index: 1;
        }

        .welcome-banner .btn {
            background: #fff;
            color: var(--fs-primary);
            border: none;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 700;
            padding: 11px 17px;
            position: relative;
            z-index: 1;
        }

            .welcome-banner .btn:hover {
                background: #edf4ff;
                color: var(--fs-primary-dark);
            }

    /* Statistics */

    .stat-card {
        height: 100%;
        background: #fff;
        border: 1px solid var(--fs-border);
        border-radius: 15px;
        padding: 22px;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 9px 24px rgba(25, 50, 90, .07);
        }

    .stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 19px;
    }

    .stat-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        font-size: 21px;
    }

    .icon-blue {
        color: #2563eb;
        background: #eaf1ff;
    }

    .icon-green {
        color: #15966b;
        background: #e5f8ef;
    }

    .icon-purple {
        color: #805ad5;
        background: #f0eaff;
    }

    .stat-label {
        color: var(--fs-muted);
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .stat-value {
        color: var(--fs-navy);
        font-size: 30px;
        font-weight: 800;
        line-height: 1.1;
        margin: 0;
    }

    .stat-note {
        font-size: 11px;
        color: #8a97a9;
        margin-top: 9px;
    }

    /* General cards */

    .content-card {
        background: #fff;
        border: 1px solid var(--fs-border);
        border-radius: 16px;
        padding: 24px;
        margin-top: 25px;
        box-shadow: 0 4px 18px rgba(25, 50, 90, .025);
    }

    .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 22px;
    }

        .section-heading h4 {
            color: var(--fs-navy);
            font-size: 17px;
            font-weight: 800;
            margin: 0;
        }

        .section-heading p {
            color: var(--fs-muted);
            font-size: 12px;
            margin: 6px 0 0;
        }

    .btn-fs-primary {
        background: var(--fs-primary);
        color: #fff;
        border: 1px solid var(--fs-primary);
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        padding: 10px 15px;
        transition: all .2s ease;
    }

        .btn-fs-primary:hover {
            background: var(--fs-primary-dark);
            border-color: var(--fs-primary-dark);
            color: #fff;
        }

    .btn-fs-outline {
        background: #fff;
        color: var(--fs-primary);
        border: 1px solid #d8e4fa;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        padding: 9px 14px;
    }

        .btn-fs-outline:hover {
            background: #edf4ff;
            color: var(--fs-primary-dark);
        }

    /* Profile */

    .profile-top {
        display: flex;
        align-items: center;
        gap: 19px;
        margin-bottom: 23px;
    }

    .profile-avatar {
        width: 100px;
        height: 100px;
        border-radius: 18px;
        object-fit: cover;
        border: 3px solid #edf3ff;
        flex-shrink: 0;
    }

    .profile-placeholder {
        width: 100px;
        height: 100px;
        border-radius: 18px;
        background: #edf4ff;
        color: var(--fs-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        flex-shrink: 0;
    }

    .profile-name {
        color: var(--fs-navy);
        font-size: 21px;
        font-weight: 800;
        margin-bottom: 7px;
        overflow-wrap: anywhere;
    }

    .profile-subtitle {
        color: var(--fs-muted);
        font-size: 13px;
        margin-bottom: 12px;
        overflow-wrap: anywhere;
    }

    .profile-details {
        border-top: 1px solid var(--fs-border);
        padding-top: 19px;
    }

    .detail-item {
        display: flex;
        gap: 11px;
        margin-bottom: 17px;
        min-width: 0;
    }

        .detail-item i {
            color: var(--fs-primary);
            font-size: 17px;
            margin-top: 2px;
        }

        .detail-item small {
            display: block;
            color: #8a97a9;
            font-size: 11px;
            margin-bottom: 4px;
        }

        .detail-item span {
            display: block;
            color: #42516a;
            font-size: 13px;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

    .skills-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 8px;
    }

    .skill-badge {
        background: #edf4ff;
        color: #2457a7;
        border-radius: 7px;
        padding: 6px 10px;
        font-size: 11px;
        font-weight: 700;
    }

    .resume-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 6px;
        padding: 10px 13px;
        background: #edf4ff;
        color: var(--fs-primary);
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700;
    }

        .resume-link:hover {
            background: #dfeaff;
            color: var(--fs-primary-dark);
        }

    .about-text {
        color: #66758a;
        font-size: 13px;
        line-height: 1.8;
        margin-top: 5px;
        overflow-wrap: anywhere;
    }

    /* Profile completion */

    .completion-box {
        background: #f7f9fd;
        border: 1px solid var(--fs-border);
        border-radius: 13px;
        padding: 17px;
        margin-bottom: 20px;
    }

    .completion-header {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 11px;
        font-size: 12px;
        font-weight: 700;
    }

        .completion-header span:first-child {
            color: #56657a;
        }

        .completion-header span:last-child {
            color: var(--fs-primary);
        }

    .completion-track {
        height: 8px;
        width: 100%;
        background: #e3eaf4;
        border-radius: 20px;
        overflow: hidden;
    }

    .completion-fill {
        height: 100%;
        background: linear-gradient(90deg, #2563eb, #60a5fa);
        border-radius: 20px;
    }

    /* Profile missing */

    .empty-profile {
        text-align: center;
        padding: 35px 20px;
    }

    .empty-profile-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 22px;
        background: #edf4ff;
        color: var(--fs-primary);
        font-size: 32px;
    }

    .empty-profile h3 {
        color: var(--fs-navy);
        font-size: 21px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .empty-profile p {
        color: var(--fs-muted);
        font-size: 13px;
        line-height: 1.8;
        max-width: 430px;
        margin: 0 auto 22px;
    }

    /* Responsive */

    @@media (max-width: 991px) {
        .student-sidebar {
            position: static;
            margin-bottom: 25px;
        }

        .dashboard-heading h1 {
            font-size: 24px;
        }
    }

    @@media (max-width: 575px) {
        .student-dashboard {
            padding-top: 18px;
        }

        .welcome-banner {
            padding: 24px 20px;
        }

            .welcome-banner h2 {
                font-size: 21px;
            }

        .stat-card {
            padding: 17px;
        }

        .stat-value {
            font-size: 26px;
        }

        .content-card {
            padding: 18px;
        }

        .profile-top {
            align-items: flex-start;
            flex-direction: column;
        }

        .section-heading {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="container-fluid student-dashboard">
    <div class="row g-4">

        <!-- Sidebar -->
        <div class="col-lg-3 col-xl-2">
            <aside class="student-sidebar">

                <div class="sidebar-brand">
                    <div class="brand-icon">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>
                    <h2 class="brand-name">FreshStart</h2>
                </div>

                <div class="sidebar-label">STUDENT MENU</div>

                <a asp-controller="Student"
                   asp-action="Index"
                   class="sidebar-link active">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="Student"
                   asp-action="EditProfile"
                   class="sidebar-link">
                    <i class="bi bi-person-circle"></i>
                    <span>My Profile</span>
                </a>

                <a asp-controller="Student"
                   asp-action="Jobs"
                   class="sidebar-link">
                    <i class="bi bi-search"></i>
                    <span>Browse Jobs</span>
                </a>

                <a asp-controller="Student"
                   asp-action="RecommendedJobs"
                   class="sidebar-link">
                    <i class="bi bi-stars"></i>
                    <span>Recommended Jobs</span>
                </a>

                <a asp-controller="Student"
                   asp-action="MyApplications"
                   class="sidebar-link">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Applications</span>
                </a>

                <a asp-controller="Student"
                   asp-action="SavedJobs"
                   class="sidebar-link">
                    <i class="bi bi-bookmark"></i>
                    <span>Saved Jobs</span>
                </a>

                <a asp-controller="Notification"
                   asp-action="Index"
                   class="sidebar-link">
                    <i class="bi bi-bell"></i>
                    <span>Notifications</span>
                </a>

                <div class="sidebar-help">
                    <i class="bi bi-lightbulb"></i>
                    <h6>Build Your Career</h6>
                    <p>Keep your profile updated to help employers understand your skills.</p>
                    <a asp-controller="Student"
                       asp-action="EditProfile">
                        Update Profile <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

            </aside>
        </div>

        <!-- Main Dashboard -->
        <div class="col-lg-9 col-xl-10">

            <!-- Heading -->
            <div class="dashboard-heading d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <h1>Student Dashboard</h1>
                    <p>Track your progress and take the next step in your career.</p>
                </div>

                <div class="dashboard-date">
                    <i class="bi bi-person-workspace"></i>
                    <span>Student Workspace</span>
                </div>
            </div>

            <!-- Welcome Banner -->
            <div class="welcome-banner">
                <h2>
                    @if (Model.Profile != null && !string.IsNullOrWhiteSpace(Model.Profile.FullName))
                    {
                        @:Welcome back, @Model.Profile.FullName!
                    }
                    else
                    {
                        @:Welcome to FreshStart!
                    }
                </h2>

                <p>
                    Your next opportunity starts here. Explore job openings,
                    discover relevant roles, and keep track of your applications
                    in one place.
                </p>

                <a asp-controller="Student"
                   asp-action="Jobs"
                   class="btn">
                    <i class="bi bi-search me-2"></i>Explore Jobs
                </a>

                <a asp-controller="Student"
                   asp-action="RecommendedJobs"
                   class="btn ms-2">
                    <i class="bi bi-stars me-2"></i>Recommended Jobs
                </a>
            </div>

            <!-- Statistics -->
            <div class="row g-3">

                <div class="col-sm-6 col-xl-4">
                    <div class="stat-card">
                        <div class="stat-top">
                            <div class="stat-icon icon-blue">
                                <i class="bi bi-person-check"></i>
                            </div>
                            <i class="bi bi-three-dots text-muted"></i>
                        </div>

                        <div class="stat-label">Profile Completion</div>
                        <h3 class="stat-value">@Model.ProfileCompletion%</h3>
                        <div class="stat-note">Keep your profile information updated</div>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-4">
                    <div class="stat-card">
                        <div class="stat-top">
                            <div class="stat-icon icon-green">
                                <i class="bi bi-file-earmark-check"></i>
                            </div>
                            <i class="bi bi-three-dots text-muted"></i>
                        </div>

                        <div class="stat-label">Total Applications</div>
                        <h3 class="stat-value">@Model.TotalApplications</h3>
                        <div class="stat-note">Jobs you have applied for</div>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-4">
                    <div class="stat-card">
                        <div class="stat-top">
                            <div class="stat-icon icon-purple">
                                <i class="bi bi-bookmark-star"></i>
                            </div>
                            <i class="bi bi-three-dots text-muted"></i>
                        </div>

                        <div class="stat-label">Saved Jobs</div>
                        <h3 class="stat-value">@Model.SavedJobs</h3>
                        <div class="stat-note">Opportunities saved for later</div>
                    </div>
                </div>

            </div>

            <!-- Profile Section -->
            <div class="content-card">

                <div class="section-heading">
                    <div>
                        <h4>My Profile</h4>
                        <p>Your professional information</p>
                    </div>

                    @if (Model.Profile != null)
                    {
                        <a asp-controller="Student"
                           asp-action="EditProfile"
                           class="btn-fs-outline">
                            <i class="bi bi-pencil-square me-1"></i>Edit Profile
                        </a>
                    }
                </div>

                @if (Model.Profile == null)
                {
                    <div class="empty-profile">
                        <div class="empty-profile-icon">
                            <i class="bi bi-person-plus"></i>
                        </div>

                        <h3>Let's Build Your Profile</h3>

                        <p>
                            Add your education, skills, experience, and resume
                            so you can present yourself to potential employers.
                        </p>

                        <a asp-controller="Student"
                           asp-action="CreateProfile"
                           class="btn-fs-primary">
                            <i class="bi bi-plus-circle me-2"></i>Create My Profile
                        </a>
                    </div>
                }
                else
                {
                    <div class="row g-4">

                        <!-- Profile Details -->
                        <div class="col-xl-7">

                            <div class="profile-top">

                                @if (!string.IsNullOrEmpty(Model.Profile.ProfileImage))
                                {
                                    <img src="@Model.Profile.ProfileImage"
                                         alt="Student profile picture"
                                         class="profile-avatar" />
                                }
                                else
                                {
                                    <div class="profile-placeholder">
                                        <i class="bi bi-person"></i>
                                    </div>
                                }

                                <div>
                                    <h3 class="profile-name">
                                        @Model.Profile.FullName
                                    </h3>

                                    <div class="profile-subtitle">
                                        <i class="bi bi-mortarboard me-1"></i>
                                        @(string.IsNullOrWhiteSpace(Model.Profile.Degree)
                                            ? "Student"
                                            : Model.Profile.Degree)
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(Model.Profile.University))
                                    {
                                        <div class="profile-subtitle mb-0">
                                            <i class="bi bi-building me-1"></i>
                                            @Model.Profile.University
                                        </div>
                                    }
                                </div>

                            </div>

                            <div class="profile-details">

                                <div class="row">

                                    <div class="col-md-6">
                                        <div class="detail-item">
                                            <i class="bi bi-mortarboard"></i>
                                            <div>
                                                <small>University</small>
                                                <span>
                                                    @(string.IsNullOrWhiteSpace(Model.Profile.University)
                                                        ? "Not added"
                                                        : Model.Profile.University)
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="detail-item">
                                            <i class="bi bi-book"></i>
                                            <div>
                                                <small>Degree</small>
                                                <span>
                                                    @(string.IsNullOrWhiteSpace(Model.Profile.Degree)
                                                        ? "Not added"
                                                        : Model.Profile.Degree)
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="detail-item">
                                            <i class="bi bi-tools"></i>
                                            <div class="w-100">
                                                <small>Skills</small>

                                                @if (!string.IsNullOrWhiteSpace(Model.Profile.Skills))
                                                {
                                                    <div class="skills-wrap">
                                                        @foreach (var skill in Model.Profile.Skills.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                                        {
                                                            <span class="skill-badge">
                                                                @skill.Trim()
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span>Skills not added yet</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="detail-item">
                                            <i class="bi bi-briefcase"></i>
                                            <div>
                                                <small>Experience</small>
                                                <span>
                                                    @(string.IsNullOrWhiteSpace(Model.Profile.Experience)
                                                        ? "Not added"
                                                        : Model.Profile.Experience)
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                @if (!string.IsNullOrWhiteSpace(Model.Profile.Bio))
                                {
                                    <div class="mt-1">
                                        <div class="detail-item">
                                            <i class="bi bi-card-text"></i>
                                            <div>
                                                <small>About Me</small>
                                                <div class="about-text">@Model.Profile.Bio</div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.Profile.ResumePath))
                                {
                                    <a href="@Model.Profile.ResumePath"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="resume-link">
                                        <i class="bi bi-file-earmark-pdf"></i>
                                        View My Resume
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                }

                            </div>
                        </div>

                        <!-- Profile Completion -->
                        <div class="col-xl-5">

                            <div class="completion-box">
                                <div class="completion-header">
                                    <span>Profile Completion</span>
                                    <span>@Model.ProfileCompletion%</span>
                                </div>

                                <div class="completion-track">
                                    <div class="completion-fill"
                                         style="width: @(Math.Clamp(Model.ProfileCompletion, 0, 100))%;">
                                    </div>
                                </div>
                            </div>

                            <div class="p-3 rounded-3" style="background:#f7f9fd;">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="stat-icon icon-blue"
                                         style="width:40px;height:40px;flex-shrink:0;">
                                        <i class="bi bi-lightbulb"></i>
                                    </div>

                                    <div>
                                        <h6 class="fw-bold mb-2" style="color:var(--fs-navy);">
                                            Improve Your Profile
                                        </h6>

                                        <p class="small mb-3" style="color:var(--fs-muted);line-height:1.7;">
                                            Add your skills, experience, and resume
                                            to help employers understand your qualifications.
                                        </p>

                                        <a asp-controller="Student"
                                           asp-action="EditProfile"
                                           class="btn-fs-outline d-inline-block">
                                            Update Information
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3 p-3 rounded-3"
                                 style="border:1px solid var(--fs-border);">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="stat-icon icon-green"
                                         style="width:40px;height:40px;flex-shrink:0;">
                                        <i class="bi bi-search"></i>
                                    </div>

                                    <div>
                                        <h6 class="fw-bold mb-1" style="color:var(--fs-navy);">
                                            Find Your Next Opportunity
                                        </h6>

                                        <a asp-controller="Student"
                                           asp-action="RecommendedJobs"
                                           class="small fw-bold"
                                           style="color:var(--fs-primary);">
                                            View Recommended Jobs
                                            <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                }

            </div>

        </div>
    </div>
</div>