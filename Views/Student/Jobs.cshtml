@model IEnumerable<FreshStart.Models.Job.Job>

@{
    ViewData["Title"] = "Available Jobs";
}


<div class="container-fluid mt-4">


    <div class="row">


        <!-- Sidebar -->

        <div class="col-md-3 mb-4">


            <div class="card shadow p-4">


                <h3 class="fw-bold text-primary">
                    FreshStart
                </h3>


                <hr />


                <a asp-controller="Student"
                   asp-action="Index"
                   class="btn btn-light text-start mb-2">

                    🏠 Dashboard

                </a>


                <a asp-controller="Student"
                   asp-action="Jobs"
                   class="btn btn-primary text-start mb-2">

                    🔍 Browse Jobs

                </a>


                <a asp-controller="Student"
                   asp-action="MyApplications"
                   class="btn btn-light text-start mb-2">

                    📄 Applications

                </a>


                <a asp-controller="Student"
                   asp-action="SavedJobs"
                   class="btn btn-light text-start">

                    ⭐ Saved Jobs

                </a>


            </div>


        </div>







        <!-- Jobs Area -->


        <div class="col-md-9">


            <h1 class="fw-bold mb-4">

                Find Your Dream Job 🚀

            </h1>





            <!-- Search Card -->


            <div class="card shadow p-4 mb-5">


                <h4 class="mb-4">
                    Search Jobs
                </h4>



                <form asp-controller="Student"
                      asp-action="Jobs"
                      method="get">



                    <div class="row">



                        <div class="col-md-4 mb-3">


                            <label>
                                Job Title / Skills
                            </label>


                            <input type="text"
                                   name="search"
                                   class="form-control"
                                   placeholder="Developer, .NET, C#" />


                        </div>





                        <div class="col-md-4 mb-3">


                            <label>
                                Location
                            </label>


                            <input type="text"
                                   name="location"
                                   class="form-control"
                                   placeholder="Karachi" />


                        </div>





                        <div class="col-md-4 mb-3">


                            <label>
                                Job Type
                            </label>



                            <select name="jobType"
                                    class="form-control">


                                <option value="">
                                    All Types
                                </option>


                                <option value="Full Time">
                                    Full Time
                                </option>


                                <option value="Part Time">
                                    Part Time
                                </option>


                                <option value="Remote">
                                    Remote
                                </option>


                            </select>


                        </div>


                    </div>



                    <button class="btn btn-primary mt-2">

                        🔍 Search Jobs

                    </button>


                </form>


            </div>







            <h2 class="fw-bold mb-4">

                Available Jobs

            </h2>





            @if (!Model.Any())
            {


                <div class="alert alert-info">

                    Currently no jobs available.

                </div>


            }
            else
            {


                <div class="row">


                    @foreach (var job in Model)
                    {


                        <div class="col-lg-6 mb-4">



                            <div class="card shadow h-100 p-4">



                                <h3 class="fw-bold">
                                    @job.JobTitle
                                </h3>



                                <hr />



                                <p>
                                    🏢

                                    <strong>
                                        Company:
                                    </strong>

                                    @job.Employer.CompanyName

                                </p>




                                <p>
                                    🛠

                                    <strong>
                                        Skills:
                                    </strong>

                                    @job.RequiredSkills

                                </p>




                                <p>
                                    📍

                                    @job.Location

                                </p>




                                <p>
                                    💰

                                    @job.Salary

                                </p>




                                <p>
                                    💼

                                    @job.JobType

                                </p>




                                <p>
                                    📅

                                    Deadline:

                                    @job.Deadline.ToShortDateString()

                                </p>





                                <a asp-controller="Student"
                                   asp-action="JobDetails"
                                   asp-route-id="@job.JobId"
                                   class="btn btn-primary">


                                    View Details


                                </a>



                            </div>



                        </div>


                    }


                </div>


            }



        </div>


    </div>


</div>