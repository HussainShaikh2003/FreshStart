@model IEnumerable<FreshStart.Models.Job.Job>

@{
    ViewData["Title"] = "Available Jobs";
}


<div class="container mt-5">


    <h1 class="mb-4">
        Find Your Dream Job
    </h1>



    <!-- Search Filter -->

    <div class="card shadow p-4 mb-5">


        <form asp-controller="Student"
              asp-action="Jobs"
              method="get">


            <div class="row">


                <div class="col-md-4">

                    <label>
                        Job Title / Skills
                    </label>

                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="e.g. Developer, .NET, C#" />

                </div>



                <div class="col-md-4">

                    <label>
                        Location
                    </label>

                    <input type="text"
                           name="location"
                           class="form-control"
                           placeholder="e.g. Karachi" />

                </div>



                <div class="col-md-4">

                    <label>
                        Job Type
                    </label>


                    <select name="jobType"
                            class="form-control">

                        <option value="">
                            All Types
                        </option>

                        <option value="Full Time">
                            Full Time
                        </option>

                        <option value="Part Time">
                            Part Time
                        </option>

                        <option value="Remote">
                            Remote
                        </option>

                    </select>


                </div>


            </div>



            <button type="submit"
                    class="btn btn-primary mt-3">

                Search Jobs

            </button>


        </form>


    </div>





    <h2 class="mb-4">
        Available Jobs
    </h2>





    @if (!Model.Any())
    {

        <div class="alert alert-info">

            Currently no jobs available.

        </div>

    }
    else
    {


        <div class="row">


            @foreach (var job in Model)
            {

                <div class="col-md-6 mb-4">


                    <div class="card shadow p-4">


                        <h3>
                            @job.JobTitle
                        </h3>


                        <hr />



                        <h5>
                            Company:
                        </h5>


                        <p>
                            @job.Employer.CompanyName
                        </p>




                        <p>
                            <strong>Skills:</strong>

                            @job.RequiredSkills
                        </p>




                        <p>
                            <strong>Location:</strong>

                            @job.Location
                        </p>




                        <p>
                            <strong>Salary:</strong>

                            @job.Salary
                        </p>




                        <p>
                            <strong>Job Type:</strong>

                            @job.JobType
                        </p>




                        <p>
                            <strong>Deadline:</strong>

                            @job.Deadline.ToShortDateString()
                        </p>




                        <a asp-controller="Student"
                           asp-action="JobDetails"
                           asp-route-id="@job.JobId"
                           class="btn btn-primary">

                            View Details

                        </a>



                    </div>


                </div>

            }


        </div>

    }


</div>