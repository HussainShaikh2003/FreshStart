@model IEnumerable<FreshStart.Models.Job.Job>

@{
    ViewData["Title"] = "Browse Jobs";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .jobs-page {
        background: #f4f7fc;
        min-height: 100vh;
        padding: 32px 0;
    }

    .jobs-sidebar,
    .search-card,
    .job-card {
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 18px;
        box-shadow: 0 5px 22px rgba(31, 55, 90, 0.06);
    }

    .jobs-sidebar {
        padding: 24px 18px;
        position: sticky;
        top: 20px;
    }

    .brand-name {
        color: #1769e0;
        font-size: 27px;
        font-weight: 800;
        letter-spacing: -0.7px;
    }

    .sidebar-label {
        color: #98a2b3;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.2px;
        margin: 25px 12px 12px;
        text-transform: uppercase;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #58677e;
        text-decoration: none;
        padding: 13px 14px;
        margin-bottom: 7px;
        border-radius: 11px;
        font-weight: 500;
        transition: all 0.2s ease;
    }

        .sidebar-link i {
            font-size: 18px;
        }

        .sidebar-link:hover {
            background: #f0f5ff;
            color: #1769e0;
        }

        .sidebar-link.active {
            background: #1769e0;
            color: #fff;
            box-shadow: 0 5px 12px rgba(23, 105, 224, 0.2);
        }

    .page-title {
        color: #172b4d;
        font-size: 32px;
        font-weight: 800;
        letter-spacing: -0.8px;
    }

    .page-subtitle {
        color: #78869a;
        font-size: 15px;
    }

    .search-card {
        padding: 26px;
        margin-bottom: 30px;
    }

    .section-title {
        color: #172b4d;
        font-size: 19px;
        font-weight: 750;
    }

    .form-label {
        color: #43516a;
        font-size: 13px;
        font-weight: 650;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        min-height: 46px;
        border: 1px solid #dfe6f0;
        border-radius: 10px;
        font-size: 14px;
        padding: 10px 13px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #1769e0;
            box-shadow: 0 0 0 3px rgba(23, 105, 224, 0.1);
        }

    .btn-search {
        background: #1769e0;
        border: none;
        border-radius: 10px;
        color: #fff;
        font-weight: 650;
        padding: 12px 22px;
        transition: 0.2s;
    }

        .btn-search:hover {
            background: #1056bd;
            color: #fff;
            transform: translateY(-1px);
        }

    .results-heading {
        color: #172b4d;
        font-size: 23px;
        font-weight: 800;
    }

    .results-count {
        color: #78869a;
        font-size: 14px;
    }

    .job-card {
        padding: 24px;
        height: 100%;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .job-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(31, 55, 90, 0.1);
        }

    .company-icon {
        width: 48px;
        height: 48px;
        border-radius: 13px;
        background: #eaf2ff;
        color: #1769e0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .job-title {
        color: #172b4d;
        font-size: 19px;
        font-weight: 750;
        margin: 0 0 5px;
        overflow-wrap: anywhere;
    }

    .company-name {
        color: #78869a;
        font-size: 13px;
        margin-bottom: 0;
    }

    .job-type-badge {
        display: inline-block;
        background: #edf4ff;
        color: #1769e0;
        font-size: 12px;
        font-weight: 650;
        padding: 6px 10px;
        border-radius: 7px;
    }

    .job-info {
        color: #65738a;
        font-size: 13px;
        margin-bottom: 13px;
        overflow-wrap: anywhere;
    }

        .job-info i {
            color: #1769e0;
            font-size: 15px;
            margin-right: 7px;
        }

        .job-info strong {
            color: #43516a;
            font-weight: 650;
        }

    .job-salary {
        background: #f5f8ff;
        border-radius: 10px;
        padding: 12px;
        margin: 17px 0;
    }

    .salary-label {
        color: #78869a;
        font-size: 12px;
        margin-bottom: 4px;
    }

    .salary-value {
        color: #1769e0;
        font-size: 16px;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .btn-details {
        display: block;
        width: 100%;
        background: #1769e0;
        border: 1px solid #1769e0;
        border-radius: 10px;
        color: #fff;
        font-weight: 650;
        padding: 11px 14px;
        text-align: center;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-details:hover {
            background: #1056bd;
            border-color: #1056bd;
            color: #fff;
        }

    .empty-state {
        background: #fff;
        border: 1px dashed #cbd6e6;
        border-radius: 18px;
        padding: 55px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 68px;
        height: 68px;
        background: #edf4ff;
        color: #1769e0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        font-size: 29px;
        margin: 0 auto 18px;
    }

    .empty-state h4 {
        color: #172b4d;
        font-weight: 750;
    }

    .empty-state p {
        color: #78869a;
        margin-bottom: 0;
    }

    @@media (max-width: 767px) {
        .jobs-page {
            padding: 20px 0;
        }

        .jobs-sidebar {
            position: static;
            margin-bottom: 24px;
        }

        .page-title {
            font-size: 26px;
        }

        .search-card {
            padding: 20px;
        }

        .job-card {
            padding: 20px;
        }
    }
</style>

<div class="jobs-page">
    <div class="container-fluid px-3 px-lg-4">
        <div class="row g-4">

            <!-- Sidebar -->
            <div class="col-lg-3 col-xl-2">
                <div class="jobs-sidebar">

                    <div class="brand-name">
                        <i class="bi bi-briefcase-fill me-2"></i>FreshStart
                    </div>

                    <div class="sidebar-label">Student Menu</div>

                    <a asp-controller="Student"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-grid-1x2"></i>
                        Dashboard
                    </a>

                    <a asp-controller="Student"
                       asp-action="Jobs"
                       class="sidebar-link active">
                        <i class="bi bi-search"></i>
                        Browse Jobs
                    </a>

                    <a asp-controller="Student"
                       asp-action="MyApplications"
                       class="sidebar-link">
                        <i class="bi bi-file-earmark-text"></i>
                        My Applications
                    </a>

                    <a asp-controller="Student"
                       asp-action="SavedJobs"
                       class="sidebar-link">
                        <i class="bi bi-bookmark"></i>
                        Saved Jobs
                    </a>

                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-9 col-xl-10">

                <!-- Page Heading -->
                <div class="mb-4">
                    <h1 class="page-title mb-2">Find Your Next Opportunity</h1>
                    <p class="page-subtitle mb-0">
                        Discover jobs that match your skills, interests, and career goals.
                    </p>
                </div>

                <!-- Search and Filters -->
                <div class="search-card">

                    <div class="d-flex align-items-center mb-4">
                        <div class="company-icon me-3">
                            <i class="bi bi-sliders"></i>
                        </div>
                        <div>
                            <h2 class="section-title mb-1">Search &amp; Filter Jobs</h2>
                            <p class="page-subtitle mb-0">
                                Refine your search to find suitable opportunities.
                            </p>
                        </div>
                    </div>

                    <form asp-controller="Student"
                          asp-action="Jobs"
                          method="get">

                        <div class="row g-3">

                            <div class="col-md-6 col-xl-4">
                                <label for="search" class="form-label">
                                    Job Title or Skills
                                </label>
                                <input type="text"
                                       id="search"
                                       name="search"
                                       class="form-control"
                                       value="@Context.Request.Query["search"]"
                                       placeholder="e.g. Developer, .NET, C#" />
                            </div>

                            <div class="col-md-6 col-xl-4">
                                <label for="location" class="form-label">
                                    Location
                                </label>
                                <input type="text"
                                       id="location"
                                       name="location"
                                       class="form-control"
                                       value="@Context.Request.Query["location"]"
                                       placeholder="e.g. Hyderabad" />
                            </div>

                            <div class="col-md-6 col-xl-4">
                                <label for="jobType" class="form-label">
                                    Job Type
                                </label>
                                <select id="jobType"
                                        name="jobType"
                                        class="form-select">
                                    <option value="">All Job Types</option>
                                    <option value="Full Time"
                                            selected="@(Context.Request.Query["jobType"] == "Full Time")">
                                        Full Time
                                    </option>
                                    <option value="Part Time"
                                            selected="@(Context.Request.Query["jobType"] == "Part Time")">
                                        Part Time
                                    </option>
                                    <option value="Remote"
                                            selected="@(Context.Request.Query["jobType"] == "Remote")">
                                        Remote
                                    </option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label for="minSalary" class="form-label">
                                    Minimum Salary (₨)
                                </label>
                                <input type="number"
                                       id="minSalary"
                                       name="minSalary"
                                       class="form-control"
                                       min="0"
                                       step="0.01"
                                       value="@Context.Request.Query["minSalary"]"
                                       placeholder="e.g. 30000" />
                            </div>

                            <div class="col-md-6">
                                <label for="maxSalary" class="form-label">
                                    Maximum Salary (₨)
                                </label>
                                <input type="number"
                                       id="maxSalary"
                                       name="maxSalary"
                                       class="form-control"
                                       min="0"
                                       step="0.01"
                                       value="@Context.Request.Query["maxSalary"]"
                                       placeholder="e.g. 80000" />
                            </div>

                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button type="submit" class="btn btn-search">
                                <i class="bi bi-search me-2"></i>Search Jobs
                            </button>

                            <a asp-controller="Student"
                               asp-action="Jobs"
                               class="btn btn-light border rounded-3 px-4 py-2">
                                <i class="bi bi-arrow-counterclockwise me-2"></i>Clear Filters
                            </a>
                        </div>

                    </form>
                </div>

                <!-- Job Results -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                    <div>
                        <h2 class="results-heading mb-1">Available Jobs</h2>
                        <p class="results-count mb-0">
                            Explore opportunities from verified employers.
                        </p>
                    </div>

                    <span class="badge rounded-pill bg-white text-primary border px-3 py-2">
                        <i class="bi bi-briefcase me-1"></i>
                        @(Model?.Count() ?? 0) Jobs Found
                    </span>
                </div>

                @if (Model == null || !Model.Any())
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-search"></i>
                        </div>
                        <h4>No Jobs Found</h4>
                        <p class="mt-2">
                            No jobs match your current search. Try changing or clearing your filters.
                        </p>

                        <a asp-controller="Student"
                           asp-action="Jobs"
                           class="btn btn-search mt-4">
                            <i class="bi bi-arrow-counterclockwise me-2"></i>View All Jobs
                        </a>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var job in Model)
                        {
                            <div class="col-md-6 col-xl-4">
                                <div class="job-card">

                                    <div class="d-flex align-items-start gap-3 mb-3">
                                        <div class="company-icon">
                                            <i class="bi bi-building"></i>
                                        </div>

                                        <div class="flex-grow-1">
                                            <h3 class="job-title">@job.JobTitle</h3>
                                            <p class="company-name">
                                                @(job.Employer?.CompanyName ?? "Company")
                                            </p>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <span class="job-type-badge">
                                            <i class="bi bi-clock me-1"></i>
                                            @job.JobType
                                        </span>
                                    </div>

                                    <div class="job-info">
                                        <i class="bi bi-geo-alt"></i>
                                        @(string.IsNullOrWhiteSpace(job.Location)
                                            ? "Location not specified"
                                            : job.Location)
                                    </div>

                                    <div class="job-info">
                                        <i class="bi bi-tools"></i>
                                        <strong>Required Skills</strong>
                                        <div class="mt-1">
                                            @(string.IsNullOrWhiteSpace(job.RequiredSkills)
                                                ? "Not specified"
                                                : job.RequiredSkills)
                                        </div>
                                    </div>

                                    <div class="job-salary">
                                        <div class="salary-label">
                                            <i class="bi bi-wallet2 me-1"></i>Salary Range
                                        </div>
                                        <div class="salary-value">
                                            ₨@job.MinimumSalary.ToString("N0")
                                            – ₨@job.MaximumSalary.ToString("N0")
                                        </div>
                                        <div class="salary-label mt-1">
                                            Per @(string.IsNullOrWhiteSpace(job.SalaryType)
                                            ? "Month"
                                            : job.SalaryType)
                                        </div>
                                    </div>

                                    <div class="job-info">
                                        <i class="bi bi-calendar-event"></i>
                                        <strong>Application Deadline:</strong>
                                        <div class="mt-1">
                                            @job.Deadline.ToShortDateString()
                                        </div>
                                    </div>

                                    <a asp-controller="Student"
                                       asp-action="JobDetails"
                                       asp-route-id="@job.JobId"
                                       class="btn-details mt-3">
                                        View Job Details
                                        <i class="bi bi-arrow-right ms-2"></i>
                                    </a>

                                </div>
                            </div>
                        }
                    </div>
                }

            </div>
        </div>
    </div>
</div>