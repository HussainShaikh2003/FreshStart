@using Microsoft.AspNetCore.Identity
@using FreshStart.Data
@using FreshStart.Models.Identity

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Context


<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - FreshStart</title>

    <link rel="stylesheet" href="~/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/FreshStart.styles.css" asp-append-version="true" />

</head>


<body>


    <header>

        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm mb-4">


            <div class="container">


                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    🚀 FreshStart
                </a>



                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">

                    <span class="navbar-toggler-icon"></span>

                </button>




                <div class="collapse navbar-collapse"
                     id="navbarNav">


                    <ul class="navbar-nav flex-grow-1">



                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>



                        @if (User.Identity.IsAuthenticated)
                        {


                            var currentUser = await UserManager.GetUserAsync(User);

                            var roles = await UserManager.GetRolesAsync(currentUser);



                            if (roles.Contains("Admin"))
                            {

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Admin"
                                       asp-action="Index">

                                        Admin Dashboard

                                    </a>

                                </li>



                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Admin"
                                       asp-action="Students">

                                        Students

                                    </a>

                                </li>



                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Admin"
                                       asp-action="Employers">

                                        Employers

                                    </a>

                                </li>



                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Admin"
                                       asp-action="Jobs">

                                        Jobs

                                    </a>

                                </li>

                            }





                            if (roles.Contains("Student"))
                            {

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Student"
                                       asp-action="Index">

                                        Dashboard

                                    </a>

                                </li>



                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Student"
                                       asp-action="Jobs">

                                        Jobs

                                    </a>

                                </li>



                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Student"
                                       asp-action="MyApplications">

                                        My Applications

                                    </a>

                                </li>

                            }





                            if (roles.Contains("Employer"))
                            {

                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Employer"
                                       asp-action="Index">

                                        Dashboard

                                    </a>

                                </li>



                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Employer"
                                       asp-action="PostJob">

                                        Post Job

                                    </a>

                                </li>



                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-controller="Employer"
                                       asp-action="Jobs">

                                        My Jobs

                                    </a>

                                </li>

                            }





                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Notification"
                                   asp-action="Index">


                                    🔔 Notifications


                                    @{
                                        var unreadCount = Context.Notifications
                                        .Count(x => x.UserId == currentUser.Id && !x.IsRead);



                                        if (unreadCount > 0)
                                        {
                                            <span class="badge bg-danger">

                                                @unreadCount

                                            </span>
                                        }

                                    }


                                </a>

                            </li>





                            <li class="nav-item">

                                <a class="nav-link text-danger"
                                   asp-controller="Account"
                                   asp-action="Logout">

                                    Logout

                                </a>

                            </li>


                        }
                        else
                        {


                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Login

                                </a>

                            </li>



                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Register">

                                    Register

                                </a>

                            </li>


                        }



                    </ul>


                </div>


            </div>


        </nav>

    </header>





    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>





    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - FreshStart -

            <a asp-controller="Home"
               asp-action="Privacy">

                Privacy

            </a>


        </div>

    </footer>





    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/main.js"></script>


    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>