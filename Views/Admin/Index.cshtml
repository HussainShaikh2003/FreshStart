@{
    ViewData["Title"] = "Admin Dashboard";
}


<div class="container mt-5">


    <h1 class="mb-4">
        Admin Dashboard
    </h1>



    <div class="row">


        <div class="col-md-3 mb-4">

            <div class="card shadow p-4 text-center">

                <h5>
                    Total Students
                </h5>


                <h2>
                    @ViewBag.TotalStudents
                </h2>

            </div>

        </div>





        <div class="col-md-3 mb-4">

            <div class="card shadow p-4 text-center">

                <h5>
                    Total Employers
                </h5>


                <h2>
                    @ViewBag.TotalEmployers
                </h2>

            </div>

        </div>





        <div class="col-md-3 mb-4">

            <div class="card shadow p-4 text-center">

                <h5>
                    Pending Approvals
                </h5>


                <h2>
                    @ViewBag.PendingEmployers
                </h2>

            </div>

        </div>





        <div class="col-md-3 mb-4">

            <div class="card shadow p-4 text-center">

                <h5>
                    Approved Companies
                </h5>


                <h2>
                    @ViewBag.ApprovedEmployers
                </h2>

            </div>

        </div>


    </div>





    <div class="card shadow p-4 mt-3">


        <h3>
            Admin Control Panel
        </h3>


        <p class="text-muted">
            Manage students, employers, jobs and approvals from here.
        </p>



        <div class="mt-3">


            <a asp-controller="Admin"
               asp-action="Students"
               class="btn btn-primary me-2">

                Manage Students

            </a>




            <a asp-controller="Admin"
               asp-action="Employers"
               class="btn btn-success me-2">

                Manage Employers

            </a>




            <a asp-controller="Admin"
               asp-action="Jobs"
               class="btn btn-warning">

                Manage Jobs

            </a>
            </a>


        </div>


    </div>



</div>