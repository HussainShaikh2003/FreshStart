@{
    ViewData["Title"] = "Admin Dashboard";
}


<div class="container-fluid mt-4">


    <!-- Admin Header -->
    <div class="p-4 mb-4 rounded shadow bg-dark text-white">

        <h1 class="fw-bold">
            👑 Welcome Admin
        </h1>

        <p class="mb-0">
            Manage FreshStart platform, users, companies and job activities.
        </p>

    </div>





    <!-- Statistics Cards -->
    <div class="row">


        <div class="col-md-3 mb-4">

            <div class="card shadow border-0 text-center p-4">

                <h6 class="text-muted">
                    👨‍🎓 Total Students
                </h6>

                <h1 class="fw-bold">
                    @ViewBag.TotalStudents
                </h1>

            </div>

        </div>





        <div class="col-md-3 mb-4">

            <div class="card shadow border-0 text-center p-4">

                <h6 class="text-muted">
                    🏢 Total Employers
                </h6>

                <h1 class="fw-bold">
                    @ViewBag.TotalEmployers
                </h1>

            </div>

        </div>





        <div class="col-md-3 mb-4">

            <div class="card shadow border-0 text-center p-4">

                <h6 class="text-muted">
                    ⏳ Pending Approvals
                </h6>

                <h1 class="fw-bold text-warning">
                    @ViewBag.PendingEmployers
                </h1>

            </div>

        </div>





        <div class="col-md-3 mb-4">

            <div class="card shadow border-0 text-center p-4">

                <h6 class="text-muted">
                    ✅ Approved Companies
                </h6>

                <h1 class="fw-bold text-success">
                    @ViewBag.ApprovedEmployers
                </h1>

            </div>

        </div>


    </div>







    <!-- Control Panel -->

    <div class="card shadow border-0 p-4 mt-3">


        <h2 class="fw-bold">
            🛠 Admin Control Center
        </h2>


        <p class="text-muted">
            Control users, employers and jobs from one place.
        </p>



        <hr />



        <div class="row mt-3">


            <div class="col-md-4 mb-3">


                <div class="card shadow-sm p-4 text-center">


                    <h4>
                        👨‍🎓 Students
                    </h4>


                    <p>
                        View and manage registered students.
                    </p>


                    <a asp-controller="Admin"
                       asp-action="Students"
                       class="btn btn-primary">

                        Manage Students

                    </a>


                </div>


            </div>






            <div class="col-md-4 mb-3">


                <div class="card shadow-sm p-4 text-center">


                    <h4>
                        🏢 Employers
                    </h4>


                    <p>
                        Approve and manage companies.
                    </p>


                    <a asp-controller="Admin"
                       asp-action="Employers"
                       class="btn btn-success">

                        Manage Employers

                    </a>


                </div>


            </div>






            <div class="col-md-4 mb-3">


                <div class="card shadow-sm p-4 text-center">


                    <h4>
                        💼 Jobs
                    </h4>


                    <p>
                        Monitor all posted jobs.
                    </p>


                    <a asp-controller="Admin"
                       asp-action="Jobs"
                       class="btn btn-warning">

                        Manage Jobs

                    </a>


                </div>


            </div>


        </div>


    </div>



</div>