<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const jobTypeLabels = @Html.Raw(jobTypeLabelsJson);
        const jobTypeCounts = @Html.Raw(jobTypeCountsJson);

        const approvalLabels = @Html.Raw(approvalLabelsJson);
        const approvalCounts = @Html.Raw(approvalCountsJson);

        // Jobs by Type
        const jobTypeCanvas = document.getElementById("jobTypeChart");

        if (jobTypeCanvas && jobTypeCounts.some(count => count > 0)) {
            new Chart(jobTypeCanvas, {
                type: "bar",
                data: {
                    labels: jobTypeLabels,
                    datasets: [{
                        label: "Number of Jobs",
                        data: jobTypeCounts,
                        backgroundColor: "#4b8df8",
                        hoverBackgroundColor: "#2675e8",
                        borderRadius: 7,
                        maxBarThickness: 42
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: "#172b4d",
                            padding: 12,
                            displayColors: false
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                color: "#78869c"
                            },
                            border: {
                                display: false
                            }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0,
                                color: "#78869c"
                            },
                            grid: {
                                color: "#edf1f7"
                            },
                            border: {
                                display: false,
                                dash: [4, 4]
                            }
                        }
                    }
                }
            });
        }

        // Employer Approval Status
        const approvalCanvas = document.getElementById("employerApprovalChart");

        if (approvalCanvas && approvalCounts.some(count => count > 0)) {
            new Chart(approvalCanvas, {
                type: "doughnut",
                data: {
                    labels: approvalLabels,
                    datasets: [{
                        data: approvalCounts,
                        backgroundColor: [
                            "#f5a623",
                            "#20b486",
                            "#ef6464"
                        ],
                        hoverOffset: 7,
                        borderWidth: 0,
                        spacing: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "70%",
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: "#172b4d",
                            padding: 12
                        }
                    }
                }
            });
        }

    });
</script>