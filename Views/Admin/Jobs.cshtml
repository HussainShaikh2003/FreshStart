@model IEnumerable<FreshStart.Models.Job.Job>

@{
    ViewData["Title"] = "Manage Jobs";
}


<div class="container-fluid mt-4">


    <div class="p-4 mb-4 rounded shadow bg-dark text-white">

        <h1 class="fw-bold">
            💼 Job Management
        </h1>

        <p class="mb-0">
            Monitor all jobs posted by registered employers.
        </p>

    </div>






    <div class="card shadow border-0 p-4">


        <h3 class="mb-4">
            All Posted Jobs
        </h3>




        <div class="table-responsive">


            <table class="table table-hover align-middle">


                <thead class="table-dark">

                    <tr>

                        <th>
                            Job Title
                        </th>


                        <th>
                            Company
                        </th>


                        <th>
                            Location
                        </th>


                        <th>
                            Salary
                        </th>


                        <th>
                            Type
                        </th>


                        <th>
                            Deadline
                        </th>


                        <th>
                            Posted
                        </th>


                        <th>
                            Action
                        </th>

                    </tr>


                </thead>




                <tbody>


                    @foreach (var job in Model)
                    {

                        <tr>


                            <td>

                                <strong>
                                    @job.JobTitle
                                </strong>

                            </td>





                            <td>

                                🏢 @job.Employer.CompanyName

                            </td>





                            <td>

                                📍 @job.Location

                            </td>





                            <td>

                                💰 @job.Salary

                            </td>





                            <td>

                                <span class="badge bg-primary">
                                    @job.JobType
                                </span>

                            </td>





                            <td>

                                ⏳ @job.Deadline.ToShortDateString()

                            </td>





                            <td>

                                @job.CreatedDate.ToShortDateString()

                            </td>




                            <td>

                                <a asp-controller="Admin"
                                   asp-action="DeleteJob"
                                   asp-route-id="@job.JobId"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Are you sure you want to delete this job?');">

                                    Delete

                                </a>

                            </td>


                        </tr>

                    }


                </tbody>


            </table>


        </div>


    </div>



</div>