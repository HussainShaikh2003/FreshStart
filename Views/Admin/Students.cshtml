@model IEnumerable<FreshStart.Models.Student.StudentProfile>

@{
    ViewData["Title"] = "Manage Students";
}



<div class="container-fluid mt-4">


    <div class="p-4 mb-4 rounded shadow bg-dark text-white">

        <h1 class="fw-bold">
            👨‍🎓 Student Management
        </h1>


        <p class="mb-0">
            View and manage registered students on FreshStart.
        </p>

    </div>






    <div class="card shadow border-0 p-4">


        <h3 class="mb-4">
            Registered Students
        </h3>




        <div class="table-responsive">


            <table class="table table-hover align-middle">


                <thead class="table-dark">

                    <tr>

                        <th>
                            Profile
                        </th>


                        <th>
                            Name
                        </th>


                        <th>
                            Email
                        </th>


                        <th>
                            University
                        </th>


                        <th>
                            Degree
                        </th>


                        <th>
                            Skills
                        </th>


                        <th>
                            Action
                        </th>


                    </tr>


                </thead>




                <tbody>


                    @foreach (var student in Model)
                    {


                        <tr>



                            <td>


                                @if (!string.IsNullOrEmpty(student.ProfileImage))
                                {

                                    <img src="@student.ProfileImage"
                                         width="70"
                                         height="70"
                                         class="rounded-circle shadow" />

                                }
                                else
                                {

                                    <span class="badge bg-secondary">
                                        No Image
                                    </span>

                                }


                            </td>





                            <td>

                                <strong>
                                    @student.FullName
                                </strong>

                            </td>





                            <td>

                                📧 @student.User.Email

                            </td>





                            <td>

                                🎓 @student.University

                            </td>





                            <td>

                                📚 @student.Degree

                            </td>





                            <td>

                                <span class="badge bg-primary">
                                    @student.Skills
                                </span>

                            </td>



                            <td>

                                <a asp-controller="Admin"
                                   asp-action="DeleteStudent"
                                   asp-route-id="@student.StudentId"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Are you sure you want to delete this student?');">

                                    Delete

                                </a>


                            </td>



                        </tr>


                    }


                </tbody>


            </table>


        </div>


    </div>



</div>