@model IEnumerable<FreshStart.Models.Student.StudentProfile>

@{
    ViewData["Title"] = "Manage Students";

    var students = Model?.ToList()
        ?? new List<FreshStart.Models.Student.StudentProfile>();

    var totalStudents = students.Count;
}

<div class="admin-dashboard admin-students-page">

    <!-- Sidebar -->
    <aside class="admin-sidebar">

        <a asp-controller="Admin"
           asp-action="Index"
           class="admin-sidebar-brand">
            <span class="admin-logo-icon">
                <i class="bi bi-briefcase-fill"></i>
            </span>
            <span>Fresh<span class="admin-brand-highlight">Start</span></span>
        </a>

        <div class="admin-sidebar-label">MAIN MENU</div>

        <nav class="admin-sidebar-nav">

            <a asp-controller="Admin"
               asp-action="Index"
               class="admin-nav-link">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>

            <a asp-controller="Admin"
               asp-action="Students"
               class="admin-nav-link active">
                <i class="bi bi-people-fill"></i>
                <span>Students</span>
            </a>

            <a asp-controller="Admin"
               asp-action="Employers"
               class="admin-nav-link">
                <i class="bi bi-buildings-fill"></i>
                <span>Employers</span>
            </a>

            <a asp-controller="Admin"
               asp-action="Jobs"
               class="admin-nav-link">
                <i class="bi bi-briefcase-fill"></i>
                <span>Manage Jobs</span>
            </a>

        </nav>

        <div class="admin-sidebar-bottom">

            <div class="admin-sidebar-help">
                <div class="admin-help-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h6>Admin Portal</h6>
                <p>Manage your FreshStart platform from one place.</p>
            </div>

            <div class="admin-sidebar-footer">
                <span class="admin-online-dot"></span>
                System Administration
            </div>

        </div>

    </aside>


    <!-- Main Content -->
    <main class="admin-main-content">

        <!-- Topbar -->
        <header class="admin-topbar">

            <div class="admin-topbar-heading">

                <div class="admin-breadcrumb">
                    Dashboard
                    <i class="bi bi-chevron-right"></i>
                    Students
                </div>

                <h1>Student Management</h1>

                <p>View and manage registered students on FreshStart.</p>

            </div>

            <div class="admin-topbar-profile">
                <div class="admin-profile-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div class="admin-profile-info">
                    <strong>Administrator</strong>
                    <span>Platform Management</span>
                </div>

                <i class="bi bi-shield-check admin-profile-shield"></i>
            </div>

        </header>


        <!-- Welcome Banner -->
        <section class="admin-students-banner">

            <div class="admin-students-banner-content">

                <span class="admin-students-eyebrow">
                    <i class="bi bi-people-fill"></i>
                    STUDENT DIRECTORY
                </span>

                <h2>Manage your student community</h2>

                <p>
                    Review student profiles, check their academic backgrounds
                    and manage registered accounts from one place.
                </p>

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="admin-students-back-button">
                    <i class="bi bi-arrow-left"></i>
                    Back to Dashboard
                </a>

            </div>

            <div class="admin-students-banner-art">
                <div class="admin-students-art-circle">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>

                <span class="admin-students-art-badge students-art-one">
                    <i class="bi bi-person-check-fill"></i>
                </span>

                <span class="admin-students-art-badge students-art-two">
                    <i class="bi bi-journal-check"></i>
                </span>
            </div>

        </section>


        <!-- Statistics -->
        <section class="admin-students-overview">

            <div class="admin-students-summary-card">

                <div class="admin-students-summary-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

                <div class="admin-students-summary-info">
                    <span>TOTAL STUDENTS</span>
                    <strong>@totalStudents</strong>
                    <small>Registered student profiles</small>
                </div>

            </div>

            <div class="admin-students-summary-note">
                <span class="admin-students-note-icon">
                    <i class="bi bi-info-circle-fill"></i>
                </span>

                <div>
                    <strong>Student Directory</strong>
                    <p>
                        Review profile information before taking any
                        account management action.
                    </p>
                </div>
            </div>

        </section>


        <!-- Students Table -->
        <section class="admin-students-list-section">

            <div class="admin-section-heading admin-students-list-heading">

                <div>
                    <h3>Registered Students</h3>
                    <p>Student profiles and academic information.</p>
                </div>

                <span class="admin-students-count-badge">
                    <i class="bi bi-person-lines-fill"></i>
                    @totalStudents Students
                </span>

            </div>


            <div class="admin-students-table-card">

                @if (students.Any())
                {
                    <div class="admin-students-table-responsive">

                        <table class="admin-students-table">

                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Email Address</th>
                                    <th>University</th>
                                    <th>Degree</th>
                                    <th>Skills</th>
                                    <th class="admin-student-action-heading">Action</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var student in students)
                                {
                                    <tr>

                                        <!-- Student Profile -->
                                        <td>
                                            <div class="admin-student-identity">

                                                @if (!string.IsNullOrWhiteSpace(student.ProfileImage))
                                                {
                                                    <img src="@student.ProfileImage"
                                                         alt="Student profile"
                                                         class="admin-student-avatar" />
                                                }
                                                else
                                                {
                                                    <div class="admin-student-avatar admin-student-avatar-placeholder">
                                                        <i class="bi bi-person-fill"></i>
                                                    </div>
                                                }

                                                <div class="admin-student-name">
                                                    <strong>
                                                        @(string.IsNullOrWhiteSpace(student.FullName)
                                                            ? "Unnamed Student"
                                                            : student.FullName)
                                                    </strong>

                                                    <span>
                                                        Student ID: @student.StudentId
                                                    </span>
                                                </div>

                                            </div>
                                        </td>


                                        <!-- Email -->
                                        <td>
                                            <div class="admin-student-email">
                                                <i class="bi bi-envelope"></i>

                                                <span>
                                                    @(student.User?.Email ?? "No email available")
                                                </span>
                                            </div>
                                        </td>


                                        <!-- University -->
                                        <td>
                                            <div class="admin-student-detail">
                                                <span class="admin-student-detail-icon">
                                                    <i class="bi bi-building"></i>
                                                </span>

                                                <span>
                                                    @(string.IsNullOrWhiteSpace(student.University)
                                                        ? "Not specified"
                                                        : student.University)
                                                </span>
                                            </div>
                                        </td>


                                        <!-- Degree -->
                                        <td>
                                            <span class="admin-student-degree">
                                                <i class="bi bi-mortarboard"></i>

                                                @(string.IsNullOrWhiteSpace(student.Degree)
                                                    ? "Not specified"
                                                    : student.Degree)
                                            </span>
                                        </td>


                                        <!-- Skills -->
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(student.Skills))
                                            {
                                                <div class="admin-student-skills"
                                                     title="@student.Skills">
                                                    @student.Skills
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="admin-student-no-skills">
                                                    Not added
                                                </span>
                                            }
                                        </td>


                                        <!-- Action -->
                                        <td>
                                            <form asp-controller="Admin"
                                                  asp-action="DeleteStudent"
                                                  asp-route-id="@student.StudentId"
                                                  method="post"
                                                  class="admin-student-delete-form"
                                                  onsubmit="return confirm('Are you sure you want to delete this student? This action cannot be undone.');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="admin-student-delete-button">
                                                    <i class="bi bi-trash3"></i>
                                                    Delete
                                                </button>

                                            </form>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="admin-students-empty-state">

                        <div class="admin-students-empty-icon">
                            <i class="bi bi-people"></i>
                        </div>

                        <h4>No students registered yet</h4>

                        <p>
                            Student profiles will appear here when students
                            register on FreshStart.
                        </p>

                        <a asp-controller="Admin"
                           asp-action="Index"
                           class="admin-students-empty-button">
                            <i class="bi bi-arrow-left"></i>
                            Return to Dashboard
                        </a>

                    </div>
                }

            </div>

        </section>


        <!-- Footer -->
        <footer class="admin-dashboard-footer">
            <span>FreshStart Administration</span>
            <span>Manage your platform with confidence.</span>
        </footer>

    </main>

</div>


<style>
    .admin-students-page {
        color: #243754;
    }

    .admin-students-banner {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 220px;
        margin-bottom: 28px;
        padding: 32px 38px;
        overflow: hidden;
        color: #fff;
        background: linear-gradient(115deg, #2454dc 0%, #3478f6 100%);
        border-radius: 19px;
    }

        .admin-students-banner::before {
            position: absolute;
            top: -115px;
            right: 105px;
            width: 300px;
            height: 300px;
            border: 1px solid rgba(255, 255, 255, 0.13);
            border-radius: 50%;
            content: "";
        }

        .admin-students-banner::after {
            position: absolute;
            right: -85px;
            bottom: -190px;
            width: 330px;
            height: 330px;
            border: 1px solid rgba(255, 255, 255, 0.13);
            border-radius: 50%;
            content: "";
        }

    .admin-students-banner-content {
        position: relative;
        z-index: 2;
        max-width: 590px;
    }

    .admin-students-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 16px;
        color: #e2ecff;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.4px;
    }

    .admin-students-banner h2 {
        margin: 0 0 12px;
        color: #fff;
        font-size: clamp(23px, 2.3vw, 31px);
        font-weight: 800;
        line-height: 1.25;
    }

    .admin-students-banner p {
        max-width: 520px;
        margin: 0 0 21px;
        color: #e8efff;
        font-size: 13px;
        line-height: 1.8;
    }

    .admin-students-back-button {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 11px 16px;
        color: #2454dc;
        background: #fff;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .admin-students-back-button:hover {
            color: #173fb9;
            box-shadow: 0 5px 15px rgba(10, 33, 95, 0.18);
            transform: translateY(-2px);
        }

    .admin-students-banner-art {
        position: relative;
        z-index: 1;
        display: flex;
        width: 175px;
        height: 150px;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        margin: 0 35px 0 20px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 42px;
        background: rgba(255, 255, 255, 0.1);
        transform: rotate(-7deg);
    }

    .admin-students-art-circle {
        display: flex;
        width: 88px;
        height: 88px;
        align-items: center;
        justify-content: center;
        color: #3478f6;
        background: #fff;
        border-radius: 25px;
        font-size: 43px;
        box-shadow: 0 12px 25px rgba(14, 40, 112, 0.16);
    }

    .admin-students-art-badge {
        position: absolute;
        display: flex;
        width: 39px;
        height: 39px;
        align-items: center;
        justify-content: center;
        color: #2766e8;
        background: #fff;
        border-radius: 12px;
        font-size: 17px;
        box-shadow: 0 6px 18px rgba(14, 40, 112, 0.14);
    }

    .students-art-one {
        top: -11px;
        left: -13px;
    }

    .students-art-two {
        right: -15px;
        bottom: -10px;
        color: #18a878;
    }

    .admin-students-overview {
        display: grid;
        grid-template-columns: minmax(240px, 0.85fr) minmax(0, 1.5fr);
        gap: 20px;
        margin-bottom: 32px;
    }

    .admin-students-summary-card {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 23px;
        background: #fff;
        border: 1px solid #e9eef7;
        border-radius: 16px;
        box-shadow: 0 7px 22px rgba(34, 64, 110, 0.04);
    }

    .admin-students-summary-icon {
        display: flex;
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        color: #3478f6;
        background: #eaf1ff;
        border-radius: 16px;
        font-size: 25px;
    }

    .admin-students-summary-info {
        display: flex;
        min-width: 0;
        flex-direction: column;
    }

        .admin-students-summary-info > span {
            margin-bottom: 5px;
            color: #8190a7;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.8px;
        }

        .admin-students-summary-info > strong {
            color: #203451;
            font-size: 30px;
            font-weight: 800;
            line-height: 1.2;
        }

        .admin-students-summary-info > small {
            margin-top: 5px;
            color: #8491a6;
            font-size: 11px;
        }

    .admin-students-summary-note {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 22px;
        background: #fff;
        border: 1px solid #e9eef7;
        border-radius: 16px;
    }

    .admin-students-note-icon {
        display: flex;
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        color: #3478f6;
        background: #edf4ff;
        border-radius: 13px;
        font-size: 19px;
    }

    .admin-students-summary-note strong {
        display: block;
        margin-bottom: 5px;
        color: #253956;
        font-size: 13px;
        font-weight: 700;
    }

    .admin-students-summary-note p {
        margin: 0;
        color: #8390a5;
        font-size: 12px;
        line-height: 1.7;
    }

    .admin-students-list-heading {
        margin-bottom: 18px;
    }

    .admin-students-count-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 12px;
        color: #326bd0;
        background: #eaf2ff;
        border-radius: 9px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .admin-students-table-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 17px;
        box-shadow: 0 8px 24px rgba(34, 64, 110, 0.045);
    }

    .admin-students-table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .admin-students-table {
        width: 100%;
        border-collapse: collapse;
        white-space: nowrap;
    }

        .admin-students-table thead {
            background: #f7f9fd;
        }

        .admin-students-table th {
            padding: 16px 18px;
            color: #7d8ba2;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.65px;
            text-align: left;
            text-transform: uppercase;
            border-bottom: 1px solid #eaf0f7;
        }

        .admin-students-table td {
            padding: 16px 18px;
            color: #5f6e84;
            font-size: 12px;
            vertical-align: middle;
            border-bottom: 1px solid #eff2f7;
        }

        .admin-students-table tbody tr:last-child td {
            border-bottom: none;
        }

        .admin-students-table tbody tr {
            transition: background 0.2s ease;
        }

            .admin-students-table tbody tr:hover {
                background: #fbfcff;
            }

    .admin-student-identity {
        display: flex;
        min-width: 175px;
        align-items: center;
        gap: 12px;
    }

    .admin-student-avatar {
        display: flex;
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        object-fit: cover;
        color: #3478f6;
        background: #edf4ff;
        border: 2px solid #edf2fa;
        border-radius: 13px;
        font-size: 21px;
    }

    .admin-student-name {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .admin-student-name strong {
            max-width: 180px;
            overflow: hidden;
            color: #243754;
            font-size: 12px;
            font-weight: 750;
            text-overflow: ellipsis;
        }

        .admin-student-name span {
            color: #91a0b5;
            font-size: 10px;
        }

    .admin-student-email {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .admin-student-email i {
            color: #8c9bb1;
            font-size: 14px;
        }

    .admin-student-detail {
        display: flex;
        max-width: 180px;
        align-items: center;
        gap: 8px;
        white-space: normal;
    }

    .admin-student-detail-icon {
        display: inline-flex;
        width: 29px;
        height: 29px;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        color: #7557d9;
        background: #f2edff;
        border-radius: 9px;
    }

    .admin-student-degree {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #52647f;
    }

        .admin-student-degree i {
            color: #7c8eaa;
        }

    .admin-student-skills {
        display: block;
        max-width: 190px;
        overflow: hidden;
        color: #3b6db6;
        background: #edf4ff;
        padding: 7px 10px;
        border-radius: 8px;
        font-size: 11px;
        line-height: 1.5;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .admin-student-no-skills {
        color: #9aa5b5;
        font-size: 11px;
        font-style: italic;
    }

    .admin-student-action-heading {
        text-align: center !important;
    }

    .admin-student-delete-form {
        margin: 0;
        text-align: center;
    }

    .admin-student-delete-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 12px;
        color: #df4b58;
        background: #fff0f1;
        border: 1px solid #ffdcdf;
        border-radius: 9px;
        font-size: 11px;
        font-weight: 700;
        transition: color 0.2s ease, background 0.2s ease;
    }

        .admin-student-delete-button:hover {
            color: #fff;
            background: #e34f5c;
            border-color: #e34f5c;
        }

    .admin-students-empty-state {
        display: flex;
        min-height: 330px;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 35px 20px;
        text-align: center;
    }

    .admin-students-empty-icon {
        display: flex;
        width: 70px;
        height: 70px;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        color: #3478f6;
        background: #edf4ff;
        border-radius: 21px;
        font-size: 31px;
    }

    .admin-students-empty-state h4 {
        margin: 0 0 9px;
        color: #243754;
        font-size: 17px;
        font-weight: 750;
    }

    .admin-students-empty-state p {
        max-width: 370px;
        margin: 0 0 19px;
        color: #8390a5;
        font-size: 12px;
        line-height: 1.8;
    }

    .admin-students-empty-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 15px;
        color: #fff;
        background: #3478f6;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
    }

        .admin-students-empty-button:hover {
            color: #fff;
            background: #245ed0;
        }

    @@media (max-width: 1000px) {
        .admin-students-overview {
            grid-template-columns: 1fr;
        }

        .admin-students-banner-art {
            margin-right: 15px;
        }
    }

    @@media (max-width: 650px) {
        .admin-students-banner {
            min-height: auto;
            padding: 25px 22px;
        }

        .admin-students-banner-art {
            display: none;
        }

        .admin-students-banner h2 {
            font-size: 24px;
        }

        .admin-students-banner p {
            font-size: 12px;
        }

        .admin-students-summary-card,
        .admin-students-summary-note {
            padding: 18px;
        }

        .admin-students-list-heading {
            align-items: flex-start;
            gap: 12px;
        }

        .admin-students-count-badge {
            font-size: 10px;
        }
    }
</style>