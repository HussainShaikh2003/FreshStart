@model FreshStart.Models.Job.Job

@{
    ViewData["Title"] = "Create Job";
}

<div class="container mt-5">
    <div class="card shadow p-5">
        <h1 class="text-center fw-bold mb-4">
            Post New Job 🚀
        </h1>

        <form asp-controller="Employer"
              asp-action="CreateJob"
              method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>

            <div class="row">
                <div class="col-md-6">

                    <div class="mb-3">
                        <label asp-for="JobTitle"
                               class="form-label fw-bold">
                            Job Title
                        </label>
                        <input asp-for="JobTitle"
                               class="form-control"
                               placeholder="e.g. Junior .NET Developer" />
                        <span asp-validation-for="JobTitle"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RequiredSkills"
                               class="form-label fw-bold">
                            Required Skills
                        </label>
                        <input asp-for="RequiredSkills"
                               class="form-control"
                               placeholder="C#, ASP.NET, SQL" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Location"
                               class="form-label fw-bold">
                            Location
                        </label>
                        <input asp-for="Location"
                               class="form-control"
                               placeholder="Karachi" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="MinimumSalary"
                               class="form-label fw-bold">
                            Minimum Salary (PKR)
                        </label>
                        <input asp-for="MinimumSalary"
                               type="number"
                               min="0"
                               step="0.01"
                               class="form-control"
                               placeholder="50000" />
                        <span asp-validation-for="MinimumSalary"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaximumSalary"
                               class="form-label fw-bold">
                            Maximum Salary (PKR)
                        </label>
                        <input asp-for="MaximumSalary"
                               type="number"
                               min="0"
                               step="0.01"
                               class="form-control"
                               placeholder="80000" />
                        <span asp-validation-for="MaximumSalary"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SalaryType"
                               class="form-label fw-bold">
                            Salary Type
                        </label>
                        <select asp-for="SalaryType"
                                class="form-select">
                            <option value="Monthly">Monthly</option>
                            <option value="Yearly">Yearly</option>
                            <option value="Hourly">Hourly</option>
                        </select>
                        <span asp-validation-for="SalaryType"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="col-md-6">

                    <div class="mb-3">
                        <label asp-for="JobType"
                               class="form-label fw-bold">
                            Job Type
                        </label>
                        <input asp-for="JobType"
                               class="form-control"
                               placeholder="Full Time / Internship" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Deadline"
                               class="form-label fw-bold">
                            Deadline
                        </label>
                        <input asp-for="Deadline"
                               type="date"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description"
                               class="form-label fw-bold">
                            Job Description
                        </label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="7"
                                  placeholder="Describe job responsibilities"></textarea>
                    </div>

                </div>
            </div>

            <button type="submit"
                    class="btn btn-primary w-100 mt-3">
                Post Job 🚀
            </button>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
