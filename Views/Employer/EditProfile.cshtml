```cshtml
@model FreshStart.Models.Employer.EmployerProfile

@{
    ViewData["Title"] = "Edit Company Profile";
}

<div class="company-profile-page">

    <!-- Page Header -->
    <div class="company-profile-header">
        <div class="company-profile-header-icon">
            <i class="bi bi-building-gear"></i>
        </div>

        <div>
            <h1>Edit Company Profile</h1>
            <p>Keep your company information updated to build trust with job seekers.</p>
        </div>
    </div>

    <form asp-controller="Employer"
          asp-action="EditProfile"
          method="post"
          enctype="multipart/form-data">

        <div class="company-profile-layout">

            <!-- Main Form -->
            <div class="company-profile-main">

                <!-- Basic Information -->
                <div class="company-profile-card">

                    <div class="company-profile-section-heading">
                        <div class="company-profile-section-icon">
                            <i class="bi bi-info-circle"></i>
                        </div>

                        <div>
                            <h4>Company Information</h4>
                            <p>Update your company's basic details.</p>
                        </div>
                    </div>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label">
                                Company Name
                            </label>

                            <div class="company-profile-input">
                                <i class="bi bi-building"></i>
                                <input asp-for="CompanyName"
                                       class="form-control"
                                       placeholder="Enter company name" />
                            </div>

                            <span asp-validation-for="CompanyName"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyEmail" class="form-label">
                                Company Email
                            </label>

                            <div class="company-profile-input">
                                <i class="bi bi-envelope"></i>
                                <input asp-for="CompanyEmail"
                                       class="form-control"
                                       placeholder="Enter company email" />
                            </div>

                            <span asp-validation-for="CompanyEmail"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">
                                Phone Number
                            </label>

                            <div class="company-profile-input">
                                <i class="bi bi-telephone"></i>
                                <input asp-for="Phone"
                                       class="form-control"
                                       placeholder="Enter phone number" />
                            </div>

                            <span asp-validation-for="Phone"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Website" class="form-label">
                                Company Website
                            </label>

                            <div class="company-profile-input">
                                <i class="bi bi-globe"></i>
                                <input asp-for="Website"
                                       class="form-control"
                                       placeholder="https://example.com" />
                            </div>

                            <span asp-validation-for="Website"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Industry" class="form-label">
                                Industry
                            </label>

                            <div class="company-profile-input">
                                <i class="bi bi-diagram-3"></i>
                                <input asp-for="Industry"
                                       class="form-control"
                                       placeholder="e.g. Information Technology" />
                            </div>

                            <span asp-validation-for="Industry"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="CompanyDescription" class="form-label">
                                Company Description
                            </label>

                            <textarea asp-for="CompanyDescription"
                                      class="form-control company-profile-textarea"
                                      rows="5"
                                      placeholder="Tell job seekers about your company, its work, and its goals..."></textarea>

                            <span asp-validation-for="CompanyDescription"
                                  class="text-danger small"></span>
                        </div>

                    </div>
                </div>

                <!-- Company Logo -->
                <div class="company-profile-card">

                    <div class="company-profile-section-heading">
                        <div class="company-profile-section-icon">
                            <i class="bi bi-image"></i>
                        </div>

                        <div>
                            <h4>Company Logo</h4>
                            <p>Upload a logo that represents your company.</p>
                        </div>
                    </div>

                    <div class="company-logo-upload-area">

                        <div class="company-logo-preview">
                            @if (!string.IsNullOrEmpty(Model.CompanyLogo))
                            {
                                <img src="@Model.CompanyLogo"
                                     alt="Current company logo" />
                            }
                            else
                            {
                                <i class="bi bi-building"></i>
                            }
                        </div>

                        <div class="company-logo-upload-content">
                            <label class="form-label" for="CompanyLogoFile">
                                Change Company Logo
                            </label>

                            <input type="file"
                                   id="CompanyLogoFile"
                                   name="CompanyLogoFile"
                                   class="form-control"
                                   accept="image/*" />

                            <small>
                                Select an image file to upload a new logo.
                                Leave this field empty to keep your current logo.
                            </small>
                        </div>

                    </div>
                </div>

            </div>

            <!-- Sidebar -->
            <div class="company-profile-sidebar">

                <!-- Approval Status -->
                <div class="company-profile-card company-status-card">

                    <div class="company-profile-section-heading">
                        <div class="company-profile-section-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>
                            <h4>Account Status</h4>
                            <p>Your employer verification status.</p>
                        </div>
                    </div>

                    <label asp-for="ApprovalStatus" class="form-label">
                        Approval Status
                    </label>

                    <input asp-for="ApprovalStatus"
                           class="form-control company-status-input"
                           readonly />

                    <div class="company-status-note">
                        <i class="bi bi-info-circle"></i>
                        <span>
                            This status is managed by the administrator.
                        </span>
                    </div>
                </div>

                <!-- Profile Tips -->
                <div class="company-profile-tips">

                    <div class="company-profile-tips-icon">
                        <i class="bi bi-lightbulb"></i>
                    </div>

                    <h5>Make a Great First Impression</h5>

                    <p>
                        A complete company profile helps students understand
                        your organization and the opportunities you offer.
                    </p>

                    <ul>
                        <li>
                            <i class="bi bi-check-circle"></i>
                            Keep your contact details accurate.
                        </li>
                        <li>
                            <i class="bi bi-check-circle"></i>
                            Add a clear company description.
                        </li>
                        <li>
                            <i class="bi bi-check-circle"></i>
                            Use your official company logo.
                        </li>
                    </ul>
                </div>

            </div>
        </div>

        <!-- Form Actions -->
        <div class="company-profile-actions">

            <a asp-controller="Employer"
               asp-action="Index"
               class="company-profile-cancel-btn">
                <i class="bi bi-arrow-left"></i>
                Cancel
            </a>

            <button type="submit" class="company-profile-save-btn">
                <i class="bi bi-check2-circle"></i>
                Update Company Profile
            </button>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .company-profile-page {
        max-width: 1250px;
        margin: 35px auto;
        padding: 0 18px 40px;
        color: #172b4d;
    }

    .company-profile-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .company-profile-header-icon {
        width: 66px;
        height: 66px;
        min-width: 66px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 19px;
        background: #e5efff;
        color: #2563eb;
        font-size: 29px;
    }

    .company-profile-header h1 {
        margin: 0 0 7px;
        font-size: 29px;
        font-weight: 750;
        letter-spacing: -0.7px;
    }

    .company-profile-header p {
        margin: 0;
        color: #75839a;
        font-size: 14px;
        line-height: 1.6;
    }

    .company-profile-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.8fr) minmax(280px, 0.85fr);
        gap: 24px;
        align-items: start;
    }

    .company-profile-main,
    .company-profile-sidebar {
        display: flex;
        flex-direction: column;
        gap: 24px;
        min-width: 0;
    }

    .company-profile-card {
        padding: 28px;
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 20px;
        box-shadow: 0 8px 28px rgba(27, 55, 100, 0.045);
    }

    .company-profile-section-heading {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 27px;
    }

    .company-profile-section-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #edf4ff;
        color: #2563eb;
        font-size: 21px;
    }

    .company-profile-section-heading h4 {
        margin: 0 0 5px;
        font-size: 17px;
        font-weight: 750;
        color: #172b4d;
    }

    .company-profile-section-heading p {
        margin: 0;
        color: #8995a8;
        font-size: 12px;
        line-height: 1.5;
    }

    .company-profile-page .form-label {
        display: block;
        margin-bottom: 9px;
        color: #35445d;
        font-size: 13px;
        font-weight: 650;
    }

    .company-profile-input {
        position: relative;
    }

        .company-profile-input > i {
            position: absolute;
            top: 50%;
            left: 14px;
            transform: translateY(-50%);
            color: #8292aa;
            font-size: 16px;
            pointer-events: none;
        }

    .company-profile-page .form-control {
        min-height: 47px;
        border: 1px solid #dfe6f0;
        border-radius: 11px;
        background-color: #fbfcff;
        color: #243550;
        font-size: 13px;
        box-shadow: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .company-profile-input .form-control {
        padding-left: 42px;
    }

    .company-profile-page .form-control:focus {
        border-color: #78a5ff;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.09);
    }

    .company-profile-page .form-control::placeholder {
        color: #a3afc0;
    }

    .company-profile-page .company-profile-textarea {
        min-height: 135px;
        padding: 14px;
        resize: vertical;
        line-height: 1.7;
    }

    .company-profile-page .text-danger {
        display: block;
        margin-top: 5px;
    }

    .company-logo-upload-area {
        display: flex;
        align-items: center;
        gap: 22px;
        padding: 20px;
        border: 1px dashed #cbd8ea;
        border-radius: 15px;
        background: #f9fbff;
    }

    .company-logo-preview {
        width: 104px;
        height: 104px;
        min-width: 104px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-radius: 17px;
        background: #eaf1ff;
        color: #4778cf;
        font-size: 39px;
    }

        .company-logo-preview img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 5px;
            background: #fff;
        }

    .company-logo-upload-content {
        flex: 1;
        min-width: 0;
    }

        .company-logo-upload-content .form-control {
            min-height: auto;
            padding: 9px;
            background: #fff;
        }

        .company-logo-upload-content small {
            display: block;
            margin-top: 9px;
            color: #8995a8;
            font-size: 11px;
            line-height: 1.7;
        }

    .company-status-input {
        background: #f3f6fb !important;
        color: #65748b !important;
        cursor: not-allowed;
    }

    .company-status-note {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin-top: 15px;
        padding: 12px;
        border-radius: 11px;
        background: #eff6ff;
        color: #52709e;
        font-size: 11px;
        line-height: 1.7;
    }

        .company-status-note i {
            margin-top: 2px;
            color: #3478dc;
        }

    .company-profile-tips {
        padding: 25px;
        border-radius: 19px;
        background: linear-gradient(145deg, #edf4ff, #f7faff);
        border: 1px solid #dce9ff;
    }

    .company-profile-tips-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        border-radius: 13px;
        background: #fff;
        color: #3478dc;
        font-size: 22px;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.07);
    }

    .company-profile-tips h5 {
        margin-bottom: 10px;
        color: #20385f;
        font-size: 16px;
        font-weight: 750;
        line-height: 1.5;
    }

    .company-profile-tips p {
        color: #6d7f9b;
        font-size: 12px;
        line-height: 1.8;
    }

    .company-profile-tips ul {
        display: flex;
        flex-direction: column;
        gap: 13px;
        margin: 18px 0 0;
        padding: 0;
        list-style: none;
    }

    .company-profile-tips li {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        color: #536987;
        font-size: 12px;
        line-height: 1.7;
    }

        .company-profile-tips li i {
            margin-top: 2px;
            color: #27865a;
        }

    .company-profile-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 13px;
        margin-top: 25px;
        padding: 20px 24px;
        border: 1px solid #e8edf5;
        border-radius: 17px;
        background: #fff;
        box-shadow: 0 5px 20px rgba(27, 55, 100, 0.035);
    }

    .company-profile-cancel-btn,
    .company-profile-save-btn {
        min-height: 45px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 0 20px;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 650;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .company-profile-cancel-btn {
        border: 1px solid #dfe6f0;
        background: #fff;
        color: #586980;
    }

        .company-profile-cancel-btn:hover {
            background: #f4f7fb;
            color: #243550;
        }

    .company-profile-save-btn {
        border: 1px solid #2563eb;
        background: #2563eb;
        color: #fff;
        cursor: pointer;
    }

        .company-profile-save-btn:hover {
            border-color: #1d4ed8;
            background: #1d4ed8;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 5px 14px rgba(37, 99, 235, 0.2);
        }

    @@media (max-width: 900px) {
        .company-profile-layout {
            grid-template-columns: 1fr;
        }

        .company-profile-sidebar {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 600px) {
        .company-profile-page {
            margin-top: 22px;
            padding: 0 12px 25px;
        }

        .company-profile-header {
            align-items: flex-start;
            gap: 13px;
        }

        .company-profile-header-icon {
            width: 51px;
            height: 51px;
            min-width: 51px;
            border-radius: 14px;
            font-size: 23px;
        }

        .company-profile-header h1 {
            font-size: 22px;
        }

        .company-profile-header p {
            font-size: 12px;
        }

        .company-profile-card {
            padding: 20px 16px;
            border-radius: 16px;
        }

        .company-profile-sidebar {
            display: flex;
        }

        .company-logo-upload-area {
            align-items: flex-start;
            flex-direction: column;
            padding: 16px;
        }

        .company-profile-actions {
            flex-direction: column-reverse;
            padding: 16px;
        }

        .company-profile-cancel-btn,
        .company-profile-save-btn {
            width: 100%;
        }
    }
</style>
