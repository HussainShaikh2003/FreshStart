@model FreshStart.Models.Employer.EmployerProfile

@{
    ViewData["Title"] = "Edit Company Profile";
}



<div class="container mt-5">


    <div class="card shadow p-5">


        <h1 class="text-center fw-bold mb-4">
            Edit Company Profile ✏️
        </h1>




        <form asp-controller="Employer"
              asp-action="EditProfile"
              method="post"
              enctype="multipart/form-data">



            <div class="row">


                <div class="col-md-6">


                    <div class="mb-3">

                        <label asp-for="CompanyName"
                               class="form-label fw-bold">
                            Company Name
                        </label>

                        <input asp-for="CompanyName"
                               class="form-control" />

                    </div>




                    <div class="mb-3">

                        <label asp-for="CompanyEmail"
                               class="form-label fw-bold">
                            Company Email
                        </label>

                        <input asp-for="CompanyEmail"
                               class="form-control" />

                    </div>




                    <div class="mb-3">

                        <label asp-for="Phone"
                               class="form-label fw-bold">
                            Phone Number
                        </label>

                        <input asp-for="Phone"
                               class="form-control" />

                    </div>




                    <div class="mb-3">

                        <label asp-for="Website"
                               class="form-label fw-bold">
                            Website
                        </label>

                        <input asp-for="Website"
                               class="form-control" />

                    </div>


                </div>





                <div class="col-md-6">


                    <div class="mb-3">

                        <label asp-for="Industry"
                               class="form-label fw-bold">
                            Industry
                        </label>

                        <input asp-for="Industry"
                               class="form-control" />

                    </div>




                    <div class="mb-3">

                        <label asp-for="CompanyDescription"
                               class="form-label fw-bold">
                            Company Description
                        </label>

                        <textarea asp-for="CompanyDescription"
                                  class="form-control"
                                  rows="5"></textarea>

                    </div>




                    <div class="mb-3">

                        <label class="form-label fw-bold">
                            Change Company Logo
                        </label>


                        <input type="file"
                               name="CompanyLogoFile"
                               class="form-control"
                               accept="image/*" />

                    </div>



                </div>


            </div>






            @if (!string.IsNullOrEmpty(Model.CompanyLogo))
            {

                <div class="text-center my-4">


                    <h5 class="fw-bold">
                        Current Logo
                    </h5>


                    <img src="@Model.CompanyLogo"
                         width="140"
                         height="140"
                         class="rounded-circle shadow" />


                </div>

            }






            <div class="mb-4">

                <label class="form-label fw-bold">
                    Approval Status
                </label>


                <input asp-for="ApprovalStatus"
                       class="form-control"
                       readonly />

            </div>






            <button type="submit"
                    class="btn btn-primary">

                Update Company Profile 🚀

            </button>




            <a asp-controller="Employer"
               asp-action="Index"
               class="btn btn-secondary ms-2">

                Cancel

            </a>




        </form>



    </div>


</div>