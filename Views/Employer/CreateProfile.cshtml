```cshtml
@model FreshStart.Models.Employer.EmployerProfile

@{
    ViewData["Title"] = "Create Company Profile";
}

<div class="create-company-page">

    <!-- Page Header -->
    <div class="create-company-header">
        <div class="create-company-header-icon">
            <i class="bi bi-building-add"></i>
        </div>

        <div>
            <h1>Create Company Profile</h1>
            <p>Introduce your company to students and start connecting with potential candidates.</p>
        </div>
    </div>

    <form asp-controller="Employer"
          asp-action="CreateProfile"
          method="post"
          enctype="multipart/form-data">

        <div asp-validation-summary="All"
             class="alert alert-danger create-company-validation">
        </div>

        <div class="create-company-layout">

            <!-- Main Form -->
            <div class="create-company-main">

                <!-- Company Information -->
                <div class="create-company-card">

                    <div class="create-company-section-heading">
                        <div class="create-company-section-icon">
                            <i class="bi bi-info-circle"></i>
                        </div>

                        <div>
                            <h4>Company Information</h4>
                            <p>Enter the basic details of your organization.</p>
                        </div>
                    </div>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label">
                                Company Name
                            </label>

                            <div class="create-company-input">
                                <i class="bi bi-building"></i>
                                <input asp-for="CompanyName"
                                       class="form-control"
                                       placeholder="Enter company name" />
                            </div>

                            <span asp-validation-for="CompanyName"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyEmail" class="form-label">
                                Company Email
                            </label>

                            <div class="create-company-input">
                                <i class="bi bi-envelope"></i>
                                <input asp-for="CompanyEmail"
                                       class="form-control"
                                       placeholder="company@example.com" />
                            </div>

                            <span asp-validation-for="CompanyEmail"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">
                                Phone Number
                            </label>

                            <div class="create-company-input">
                                <i class="bi bi-telephone"></i>
                                <input asp-for="Phone"
                                       class="form-control"
                                       placeholder="03xx-xxxxxxx" />
                            </div>

                            <span asp-validation-for="Phone"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Website" class="form-label">
                                Company Website
                            </label>

                            <div class="create-company-input">
                                <i class="bi bi-globe"></i>
                                <input asp-for="Website"
                                       class="form-control"
                                       placeholder="https://company.com" />
                            </div>

                            <span asp-validation-for="Website"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Industry" class="form-label">
                                Industry
                            </label>

                            <div class="create-company-input">
                                <i class="bi bi-diagram-3"></i>
                                <input asp-for="Industry"
                                       class="form-control"
                                       placeholder="e.g. Software Development, IT, Marketing" />
                            </div>

                            <span asp-validation-for="Industry"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="CompanyDescription" class="form-label">
                                Company Description
                            </label>

                            <textarea asp-for="CompanyDescription"
                                      class="form-control create-company-textarea"
                                      rows="5"
                                      placeholder="Tell students about your company, its work, and the opportunities you offer..."></textarea>

                            <span asp-validation-for="CompanyDescription"
                                  class="text-danger small"></span>
                        </div>

                    </div>
                </div>

                <!-- Logo Upload -->
                <div class="create-company-card">

                    <div class="create-company-section-heading">
                        <div class="create-company-section-icon">
                            <i class="bi bi-image"></i>
                        </div>

                        <div>
                            <h4>Company Branding</h4>
                            <p>Add your company logo to personalize your profile.</p>
                        </div>
                    </div>

                    <div class="create-company-logo-area">

                        <div class="create-company-logo-preview"
                             id="companyLogoPreview">
                            <i class="bi bi-building"></i>
                        </div>

                        <div class="create-company-logo-content">
                            <label for="CompanyLogoFile" class="form-label">
                                Upload Company Logo
                            </label>

                            <input type="file"
                                   id="CompanyLogoFile"
                                   name="CompanyLogoFile"
                                   class="form-control"
                                   accept="image/*" />

                            <small>
                                Choose an image file for your company logo.
                                A clear logo helps students recognize your organization.
                            </small>

                            <div id="companyLogoFileName"
                                 class="create-company-file-name">
                            </div>
                        </div>

                    </div>
                </div>

            </div>

            <!-- Sidebar -->
            <div class="create-company-sidebar">

                <div class="create-company-welcome-card">

                    <div class="create-company-welcome-icon">
                        <i class="bi bi-briefcase"></i>
                    </div>

                    <span class="create-company-eyebrow">
                        WELCOME TO FRESHSTART
                    </span>

                    <h3>Build Your Company's Presence</h3>

                    <p>
                        Create your company profile to present your organization
                        professionally and prepare to connect with students.
                    </p>

                    <div class="create-company-divider"></div>

                    <div class="create-company-benefit">
                        <div class="create-company-benefit-icon">
                            <i class="bi bi-person-check"></i>
                        </div>

                        <div>
                            <h6>Connect with Students</h6>
                            <p>Help job seekers learn about your organization.</p>
                        </div>
                    </div>

                    <div class="create-company-benefit">
                        <div class="create-company-benefit-icon">
                            <i class="bi bi-file-earmark-person"></i>
                        </div>

                        <div>
                            <h6>Discover Candidates</h6>
                            <p>Prepare your employer profile for recruitment.</p>
                        </div>
                    </div>

                    <div class="create-company-benefit">
                        <div class="create-company-benefit-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>
                            <h6>Administrator Review</h6>
                            <p>Your profile may need approval before posting jobs.</p>
                        </div>
                    </div>

                </div>

                <div class="create-company-tip-card">
                    <i class="bi bi-lightbulb"></i>

                    <div>
                        <h5>Profile Tip</h5>
                        <p>
                            Provide accurate contact details and a meaningful
                            company description so students can understand
                            your organization.
                        </p>
                    </div>
                </div>

            </div>

        </div>

        <!-- Submit Action -->
        <div class="create-company-actions">

            <div class="create-company-actions-text">
                <i class="bi bi-check-circle"></i>

                <span>
                    Review your company details before creating your profile.
                </span>
            </div>

            <button type="submit" class="create-company-submit-btn">
                <i class="bi bi-building-add"></i>
                Create Company Profile
                <i class="bi bi-arrow-right"></i>
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const logoInput = document.getElementById("CompanyLogoFile");
            const logoPreview = document.getElementById("companyLogoPreview");
            const fileName = document.getElementById("companyLogoFileName");

            if (!logoInput || !logoPreview || !fileName) {
                return;
            }

            logoInput.addEventListener("change", function () {
                const file = this.files && this.files.length > 0
                    ? this.files[0]
                    : null;

                fileName.textContent = "";

                if (!file) {
                    logoPreview.innerHTML = '<i class="bi bi-building"></i>';
                    return;
                }

                if (!file.type.startsWith("image/")) {
                    fileName.textContent = "Please select an image file.";
                    logoInput.value = "";
                    logoPreview.innerHTML = '<i class="bi bi-building"></i>';
                    return;
                }

                fileName.textContent = file.name;

                const reader = new FileReader();

                reader.onload = function (event) {
                    logoPreview.innerHTML = "";

                    const image = document.createElement("img");
                    image.src = event.target.result;
                    image.alt = "Selected company logo preview";

                    logoPreview.appendChild(image);
                };

                reader.readAsDataURL(file);
            });
        });
    </script>
}

