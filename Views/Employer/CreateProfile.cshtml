@model FreshStart.Models.Employer.EmployerProfile

@{
    ViewData["Title"] = "Create Company Profile";
}


<div class="container mt-5">


    <div class="card shadow p-5">


        <h1 class="text-center fw-bold mb-4">
            Create Company Profile 🏢
        </h1>



        <form asp-controller="Employer"
              asp-action="CreateProfile"
              method="post"
              enctype="multipart/form-data">


            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>



            <div class="row">


                <div class="col-md-6">


                    <div class="mb-3">

                        <label asp-for="CompanyName"
                               class="form-label fw-bold">
                            Company Name
                        </label>

                        <input asp-for="CompanyName"
                               class="form-control"
                               placeholder="Enter company name" />

                        <span asp-validation-for="CompanyName"
                              class="text-danger">
                        </span>

                    </div>



                    <div class="mb-3">

                        <label asp-for="CompanyEmail"
                               class="form-label fw-bold">
                            Company Email
                        </label>

                        <input asp-for="CompanyEmail"
                               class="form-control"
                               placeholder="company@email.com" />

                    </div>



                    <div class="mb-3">

                        <label asp-for="Phone"
                               class="form-label fw-bold">
                            Phone Number
                        </label>

                        <input asp-for="Phone"
                               class="form-control"
                               placeholder="03xx-xxxxxxx" />

                    </div>



                    <div class="mb-3">

                        <label asp-for="Website"
                               class="form-label fw-bold">
                            Website
                        </label>

                        <input asp-for="Website"
                               class="form-control"
                               placeholder="https://company.com" />

                    </div>


                </div>




                <div class="col-md-6">


                    <div class="mb-3">

                        <label asp-for="Industry"
                               class="form-label fw-bold">
                            Industry
                        </label>

                        <input asp-for="Industry"
                               class="form-control"
                               placeholder="Software, IT..." />

                    </div>



                    <div class="mb-3">

                        <label asp-for="CompanyDescription"
                               class="form-label fw-bold">
                            Company Description
                        </label>


                        <textarea asp-for="CompanyDescription"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Describe your company"></textarea>

                    </div>



                    <div class="mb-3">


                        <label class="form-label fw-bold">
                            Upload Company Logo
                        </label>


                        <input type="file"
                               name="CompanyLogoFile"
                               class="form-control"
                               accept="image/*" />


                    </div>


                </div>


            </div>



            <button type="submit"
                    class="btn btn-primary w-100 mt-3">

                Create Company Profile 🚀

            </button>



        </form>


    </div>


</div>




@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}