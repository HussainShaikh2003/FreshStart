@model List<FreshStart.Models.Application.JobApplication>

@{
    ViewData["Title"] = "Applicants";
}


<div class="container-fluid mt-4">


    <h1 class="fw-bold mb-4">
        Job Applicants 👥
    </h1>



    @if (Model.Count == 0)
    {

        <div class="alert alert-info shadow">

            No applicants found.

        </div>

    }
    else
    {


        @foreach (var application in Model)
        {


            <div class="card shadow p-4 mb-4">


                <div class="d-flex justify-content-between align-items-center">


                    <div>

                        <h3 class="fw-bold">
                            @application.Student.FullName
                        </h3>


                        <span class="badge bg-primary">
                            @application.Status
                        </span>

                    </div>


                    <div>

                        <small class="text-muted">

                            Applied:
                            @application.AppliedDate.ToShortDateString()

                        </small>

                    </div>


                </div>



                <hr />



                <div class="row">


                    <div class="col-md-6">


                        <p>
                            🎓 <strong>University:</strong>
                            @application.Student.University
                        </p>


                        <p>
                            📚 <strong>Degree:</strong>
                            @application.Student.Degree
                        </p>



                    </div>




                    <div class="col-md-6">


                        <p>
                            🛠 <strong>Skills:</strong>
                            @application.Student.Skills
                        </p>


                        <p>
                            💼 <strong>Experience:</strong>
                            @application.Student.Experience
                        </p>


                    </div>


                </div>





                @if (!string.IsNullOrEmpty(application.Student.ResumePath))
                {

                    <a href="@application.Student.ResumePath"
                       target="_blank"
                       class="btn btn-outline-primary mb-3">

                        📄 View Resume

                    </a>

                }







                <form asp-controller="Employer"
                      asp-action="UpdateApplicationStatus"
                      method="post">


                    <input type="hidden"
                           name="applicationId"
                           value="@application.ApplicationId" />



                    <div class="d-flex flex-wrap gap-2">


                        <button type="submit"
                                name="status"
                                value="Reviewed"
                                class="btn btn-secondary">

                            Review

                        </button>




                        <button type="submit"
                                name="status"
                                value="Shortlisted"
                                class="btn btn-primary">

                            Shortlist

                        </button>





                        <a asp-controller="Employer"
                           asp-action="ScheduleInterview"
                           asp-route-id="@application.ApplicationId"
                           class="btn btn-warning">

                            📅 Schedule Interview

                        </a>





                        <button type="submit"
                                name="status"
                                value="Selected"
                                class="btn btn-success">

                            Select

                        </button>





                        <button type="submit"
                                name="status"
                                value="Rejected"
                                class="btn btn-danger">

                            Reject

                        </button>


                    </div>


                </form>



            </div>


        }


    }


</div>