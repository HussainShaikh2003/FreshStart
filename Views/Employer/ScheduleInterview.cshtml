@model FreshStart.Models.Application.JobApplication

@{
    ViewData["Title"] = "Schedule Interview";
}



<div class="container mt-5">


    <div class="card shadow p-5">


        <h1 class="text-center fw-bold mb-4">
            Schedule Interview 📅
        </h1>




        <div class="card bg-light p-4 mb-4">


            <h4 class="fw-bold">
                Candidate Information
            </h4>


            <hr />


            <p>
                👤 <strong>Student:</strong>
                @Model.Student.FullName
            </p>



            <p>
                💼 <strong>Job:</strong>
                @Model.Job.JobTitle
            </p>


        </div>





        <form asp-controller="Employer"
              asp-action="ScheduleInterview"
              method="post">


            <input type="hidden"
                   name="applicationId"
                   value="@Model.ApplicationId" />




            <div class="mb-3">


                <label class="form-label fw-bold">
                    Interview Date
                </label>


                <input type="date"
                       name="interviewDate"
                       class="form-control" />


            </div>





            <div class="mb-3">


                <label class="form-label fw-bold">
                    Interview Time
                </label>


                <input type="text"
                       name="interviewTime"
                       class="form-control"
                       placeholder="10:00 AM" />


            </div>





            <div class="mb-3">


                <label class="form-label fw-bold">
                    Interview Location / Link
                </label>


                <input type="text"
                       name="interviewLocation"
                       class="form-control"
                       placeholder="Google Meet Link" />


            </div>





            <button type="submit"
                    class="btn btn-success w-100">

                Schedule Interview ✅

            </button>


        </form>


    </div>


</div>