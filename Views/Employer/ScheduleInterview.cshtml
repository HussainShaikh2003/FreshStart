```cshtml
@model FreshStart.Models.Application.JobApplication

@{
    ViewData["Title"] = "Schedule Interview";
}

<div class="interview-page">

    <!-- Header -->
    <div class="interview-page-header">
        <div>
            <div class="interview-eyebrow">
                <i class="bi bi-calendar2-check"></i>
                EMPLOYER WORKSPACE
            </div>

            <h1>Schedule an Interview</h1>

            <p>Set up a meeting and take the next step in your hiring process.</p>
        </div>

        <div class="interview-header-icon">
            <i class="bi bi-calendar2-week"></i>
        </div>
    </div>

    <!-- Main Layout -->
    <div class="interview-layout">

        <!-- Left Candidate Panel -->
        <aside class="interview-candidate-panel">

            <div class="interview-panel-top">
                <span class="interview-panel-label">INTERVIEWING</span>

                <div class="interview-candidate-avatar">
                    <i class="bi bi-person"></i>
                </div>

                <h3>@Model.Student.FullName</h3>

                <p>Job Applicant</p>

                <div class="interview-candidate-status">
                    <span></span>
                    Interview Scheduling
                </div>
            </div>

            <div class="interview-candidate-details">

                <div class="interview-info-row">
                    <div class="interview-info-icon">
                        <i class="bi bi-person-badge"></i>
                    </div>

                    <div>
                        <span>Candidate Name</span>
                        <strong>@Model.Student.FullName</strong>
                    </div>
                </div>

                <div class="interview-info-row">
                    <div class="interview-info-icon">
                        <i class="bi bi-briefcase"></i>
                    </div>

                    <div>
                        <span>Position Applied For</span>
                        <strong>@Model.Job.JobTitle</strong>
                    </div>
                </div>

                <div class="interview-info-row">
                    <div class="interview-info-icon">
                        <i class="bi bi-calendar-event"></i>
                    </div>

                    <div>
                        <span>Interview Type</span>
                        <strong>To Be Confirmed</strong>
                    </div>
                </div>

            </div>

            <div class="interview-candidate-note">
                <i class="bi bi-lightbulb"></i>

                <div>
                    <strong>Before You Schedule</strong>

                    <p>
                        Choose a suitable date and time, then provide the
                        meeting location or online interview link.
                    </p>
                </div>
            </div>

        </aside>

        <!-- Right Scheduling Form -->
        <section class="interview-form-panel">

            <div class="interview-form-heading">
                <div>
                    <span class="interview-step-label">INTERVIEW SETUP</span>
                    <h2>Meeting Details</h2>
                    <p>Fill in the details for the candidate's interview.</p>
                </div>

                <div class="interview-form-heading-icon">
                    <i class="bi bi-calendar-plus"></i>
                </div>
            </div>

            <form asp-controller="Employer"
                  asp-action="ScheduleInterview"
                  method="post">

                <input type="hidden"
                       name="applicationId"
                       value="@Model.ApplicationId" />

                <!-- Date -->
                <div class="interview-form-section">

                    <div class="interview-section-title">
                        <div class="interview-section-number">01</div>

                        <div>
                            <h4>Select Interview Date</h4>
                            <p>Choose the day for the interview.</p>
                        </div>
                    </div>

                    <label for="interviewDate" class="interview-field-label">
                        Interview Date <span>*</span>
                    </label>

                    <div class="interview-input-wrapper">
                        <i class="bi bi-calendar3"></i>

                        <input type="date"
                               id="interviewDate"
                               name="interviewDate"
                               class="form-control"
                               required />
                    </div>

                </div>

                <!-- Time -->
                <div class="interview-form-section">

                    <div class="interview-section-title">
                        <div class="interview-section-number">02</div>

                        <div>
                            <h4>Set Interview Time</h4>
                            <p>Choose a convenient meeting time.</p>
                        </div>
                    </div>

                    <label for="interviewTime" class="interview-field-label">
                        Interview Time <span>*</span>
                    </label>

                    <div class="interview-input-wrapper">
                        <i class="bi bi-clock"></i>

                        <input type="text"
                               id="interviewTime"
                               name="interviewTime"
                               class="form-control"
                               placeholder="e.g. 10:00 AM"
                               required />
                    </div>

                    <div class="interview-field-hint">
                        <i class="bi bi-info-circle"></i>
                        Example: 10:00 AM or 02:30 PM
                    </div>

                </div>

                <!-- Location -->
                <div class="interview-form-section">

                    <div class="interview-section-title">
                        <div class="interview-section-number">03</div>

                        <div>
                            <h4>Meeting Location</h4>
                            <p>Tell the candidate where the interview will take place.</p>
                        </div>
                    </div>

                    <label for="interviewLocation" class="interview-field-label">
                        Location or Meeting Link <span>*</span>
                    </label>

                    <div class="interview-input-wrapper">
                        <i class="bi bi-camera-video"></i>

                        <input type="text"
                               id="interviewLocation"
                               name="interviewLocation"
                               class="form-control"
                               placeholder="Office address or Google Meet link"
                               required />
                    </div>

                    <div class="interview-location-options">

                        <div>
                            <i class="bi bi-camera-video"></i>
                            <span>Online Meeting</span>
                        </div>

                        <div>
                            <i class="bi bi-geo-alt"></i>
                            <span>Office Interview</span>
                        </div>

                    </div>

                </div>

                <!-- Actions -->
                <div class="interview-form-actions">

                    <button type="submit" class="interview-submit-btn">
                        <i class="bi bi-calendar2-check"></i>
                        Schedule Interview
                        <i class="bi bi-arrow-right"></i>
                    </button>

                    <a asp-controller="Employer"
                       asp-action="Applicants"
                       class="interview-cancel-btn">
                        Cancel
                    </a>

                </div>

            </form>

        </section>

    </div>

    <!-- Bottom Note -->
    <div class="interview-bottom-note">
        <div class="interview-bottom-note-icon">
            <i class="bi bi-shield-check"></i>
        </div>

        <div>
            <strong>Keep your interview details accurate</strong>

            <p>
                Double-check the date, time and meeting location before
                scheduling so the candidate receives the correct information.
            </p>
        </div>
    </div>

</div>

<style>
