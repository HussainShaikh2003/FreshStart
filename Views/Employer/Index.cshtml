@model FreshStart.Models.Employer.EmployerProfile

@{
    ViewData["Title"] = "Employer Dashboard";
}


<div class="container mt-5">


    <h1 class="mb-4">
        Employer Dashboard
    </h1>




    @if (Model == null)
    {

        <div class="card shadow p-4 text-center">


            <h3>
                Welcome to FreshStart!
            </h3>


            <p class="text-muted">
                Your company profile is not created yet.
            </p>



            <a asp-controller="Employer"
               asp-action="CreateProfile"
               class="btn btn-primary">

                Create Company Profile

            </a>


        </div>

    }
    else
    {


        <div class="card shadow p-4">


            <div class="row align-items-center">


                <div class="col-md-3 text-center">


                    @if (!string.IsNullOrEmpty(Model.CompanyLogo))
                    {

                        <img src="@Model.CompanyLogo"
                             width="150"
                             height="150"
                             class="rounded shadow" />

                    }
                    else
                    {

                        <div class="bg-secondary text-white p-5">

                            No Logo

                        </div>

                    }


                </div>





                <div class="col-md-9">


                    <div class="d-flex justify-content-between">


                        <h2>
                            @Model.CompanyName
                        </h2>



                        <a asp-controller="Employer"
                           asp-action="EditProfile"
                           class="btn btn-success">

                            Edit Profile

                        </a>


                    </div>



                    <hr />



                    <p>
                        <strong>Email:</strong>
                        @Model.CompanyEmail
                    </p>



                    <p>
                        <strong>Phone:</strong>
                        @Model.Phone
                    </p>



                    <p>
                        <strong>Website:</strong>
                        @Model.Website
                    </p>



                    <p>
                        <strong>Industry:</strong>
                        @Model.Industry
                    </p>



                    <p>
                        <strong>Description:</strong>
                        @Model.CompanyDescription
                    </p>




                    <p>
                        <strong>Status:</strong>

                        @if (Model.ApprovalStatus == "Approved")
                        {
                            <span class="badge bg-success">
                                Approved
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning">
                                @Model.ApprovalStatus
                            </span>
                        }

                    </p>



                    <hr />



                    <h4>
                        Job Management
                    </h4>



                    <a asp-controller="Employer"
                       asp-action="CreateJob"
                       class="btn btn-primary me-2">

                        Post New Job

                    </a>



                    <a asp-controller="Employer"
                       asp-action="Jobs"
                       class="btn btn-info">

                        My Jobs

                    </a>



                </div>


            </div>


        </div>


    }



</div>