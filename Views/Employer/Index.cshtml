@model FreshStart.Models.Employer.EmployerProfile

@{
    ViewData["Title"] = "Employer Dashboard";
}

<div class="employer-dashboard">

    <!-- Sidebar -->
    <aside class="employer-sidebar">

        <a asp-controller="Employer"
           asp-action="Index"
           class="employer-sidebar-brand">

            <span class="employer-brand-icon">
                <i class="bi bi-briefcase-fill"></i>
            </span>

            <span>Fresh<span class="employer-brand-highlight">Start</span></span>
        </a>

        <div class="employer-sidebar-label">WORKSPACE</div>

        <nav class="employer-sidebar-nav">

            <a asp-controller="Employer"
               asp-action="Index"
               class="employer-nav-link active">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>

            <a asp-controller="Employer"
               asp-action="EditProfile"
               class="employer-nav-link">
                <i class="bi bi-buildings-fill"></i>
                <span>Company Profile</span>
            </a>

            @if (Model != null && Model.ApprovalStatus == "Approved")
            {
                <a asp-controller="Employer"
                   asp-action="CreateJob"
                   class="employer-nav-link">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>Post a Job</span>
                </a>
            }
            else
            {
                <div class="employer-nav-link employer-nav-disabled"
                     title="Employer approval is required before posting jobs">
                    <i class="bi bi-lock-fill"></i>
                    <span>Post a Job</span>
                    <i class="bi bi-lock employer-nav-lock"></i>
                </div>
            }

            <a asp-controller="Employer"
               asp-action="Jobs"
               class="employer-nav-link">
                <i class="bi bi-briefcase-fill"></i>
                <span>My Jobs</span>
            </a>

            <a asp-controller="Notification"
               asp-action="Index"
               class="employer-nav-link">
                <i class="bi bi-bell-fill"></i>
                <span>Notifications</span>
            </a>

        </nav>

        <div class="employer-sidebar-bottom">

            <div class="employer-sidebar-help">

                <div class="employer-help-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <h6>Employer Portal</h6>

                <p>
                    Manage your company profile and job opportunities
                    from one place.
                </p>

            </div>

            <div class="employer-sidebar-footer">
                <span class="employer-online-dot"></span>
                FreshStart Workspace
            </div>

        </div>

    </aside>


    <!-- Main Content -->
    <main class="employer-main-content">

        <!-- Topbar -->
        <header class="employer-topbar">

            <div class="employer-topbar-heading">

                <div class="employer-breadcrumb">
                    Workspace
                    <i class="bi bi-chevron-right"></i>
                    Dashboard
                </div>

                <h1>Employer Dashboard</h1>

                <p>Manage your company and hiring activities.</p>

            </div>

            <div class="employer-topbar-profile">

                <div class="employer-topbar-avatar">
                    <i class="bi bi-buildings-fill"></i>
                </div>

                <div class="employer-topbar-info">
                    <strong>
                        @(Model != null && !string.IsNullOrWhiteSpace(Model.CompanyName)
                            ? Model.CompanyName
                            : "Employer Account")
                    </strong>

                    <span>Employer Workspace</span>
                </div>

                <i class="bi bi-shield-check employer-topbar-shield"></i>

            </div>

        </header>


        @if (Model == null)
        {
            <!-- Profile Not Created -->
            <section class="employer-welcome-banner">

                <div class="employer-welcome-content">

                    <span class="employer-welcome-label">
                        <i class="bi bi-stars"></i>
                        WELCOME TO FRESHSTART
                    </span>

                    <h2>Build your company presence.</h2>

                    <p>
                        Create your company profile to introduce your
                        organization and start your hiring journey on FreshStart.
                    </p>

                    <a asp-controller="Employer"
                       asp-action="CreateProfile"
                       class="employer-primary-button">
                        <i class="bi bi-plus-circle"></i>
                        Create Company Profile
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

                <div class="employer-banner-art">
                    <div class="employer-art-main">
                        <i class="bi bi-buildings-fill"></i>
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>

                    <div class="employer-art-small employer-art-one">
                        <i class="bi bi-person-workspace"></i>
                    </div>

                    <div class="employer-art-small employer-art-two">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>

            </section>

            <section class="employer-setup-card">

                <div class="employer-setup-icon">
                    <i class="bi bi-building-add"></i>
                </div>

                <div class="employer-setup-content">
                    <span class="employer-setup-step">GET STARTED</span>
                    <h3>Set up your company profile</h3>
                    <p>
                        Add your company details, contact information,
                        industry and description to complete your profile.
                    </p>
                </div>

                <a asp-controller="Employer"
                   asp-action="CreateProfile"
                   class="employer-outline-button">
                    Create Profile
                    <i class="bi bi-arrow-right"></i>
                </a>

            </section>
        }
        else
        {
            <!-- Welcome Banner -->
            <section class="employer-welcome-banner">

                <div class="employer-welcome-content">

                    <span class="employer-welcome-label">
                        <i class="bi bi-stars"></i>
                        EMPLOYER OVERVIEW
                    </span>

                    <h2>
                        Welcome@(string.IsNullOrWhiteSpace(Model.CompanyName)
                     ? " back!"
                     : ", " + Model.CompanyName + "!")
                    </h2>

                    <p>
                        Manage your company profile, create job opportunities
                        and connect with talented candidates through FreshStart.
                    </p>

                    <div class="employer-welcome-actions">

                        @if (Model.ApprovalStatus == "Approved")
                        {
                            <a asp-controller="Employer"
                               asp-action="CreateJob"
                               class="employer-primary-button">
                                <i class="bi bi-plus-circle"></i>
                                Post a Job
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                        else
                        {
                            <span class="employer-approval-button">
                                <i class="bi bi-hourglass-split"></i>
                                Awaiting Employer Approval
                            </span>
                        }

                        <a asp-controller="Employer"
                           asp-action="Jobs"
                           class="employer-secondary-button">
                            View My Jobs
                            <i class="bi bi-arrow-up-right"></i>
                        </a>

                    </div>

                </div>

                <div class="employer-banner-art">

                    <div class="employer-art-main">
                        <i class="bi bi-buildings-fill"></i>
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>

                    <div class="employer-art-small employer-art-one">
                        <i class="bi bi-person-workspace"></i>
                    </div>

                    <div class="employer-art-small employer-art-two">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>

                </div>

            </section>


            <!-- Company Profile Section Heading -->
            <div class="employer-section-heading">

                <div>
                    <h3>Company Overview</h3>
                    <p>Your company information and account status.</p>
                </div>

                <a asp-controller="Employer"
                   asp-action="EditProfile"
                   class="employer-heading-action">
                    <i class="bi bi-pencil-square"></i>
                    Edit Profile
                </a>

            </div>


            <!-- Company Profile Card -->
            <section class="employer-company-card">

                <div class="employer-company-card-top">

                    <div class="employer-company-identity">

                        @if (!string.IsNullOrWhiteSpace(Model.CompanyLogo))
                        {
                            <img src="@Model.CompanyLogo"
                                 alt="Company logo"
                                 class="employer-company-logo" />
                        }
                        else
                        {
                            <div class="employer-company-logo-placeholder">
                                <i class="bi bi-buildings-fill"></i>
                            </div>
                        }

                        <div class="employer-company-heading">

                            <span class="employer-company-label">COMPANY PROFILE</span>

                            <h2>
                                @(string.IsNullOrWhiteSpace(Model.CompanyName)
                                    ? "Your Company"
                                    : Model.CompanyName)
                            </h2>

                            <span class="employer-industry-badge">
                                <i class="bi bi-diagram-3-fill"></i>
                                @(string.IsNullOrWhiteSpace(Model.Industry)
                                    ? "Industry not specified"
                                    : Model.Industry)
                            </span>

                        </div>

                    </div>


                    <div class="employer-approval-status">

                        @if (Model.ApprovalStatus == "Approved")
                        {
                            <span class="employer-status-badge employer-status-approved">
                                <i class="bi bi-check-circle-fill"></i>
                                Approved
                            </span>
                        }
                        else if (Model.ApprovalStatus == "Rejected")
                        {
                            <span class="employer-status-badge employer-status-rejected">
                                <i class="bi bi-x-circle-fill"></i>
                                Rejected
                            </span>
                        }
                        else
                        {
                            <span class="employer-status-badge employer-status-pending">
                                <i class="bi bi-hourglass-split"></i>
                                @(string.IsNullOrWhiteSpace(Model.ApprovalStatus)
                                    ? "Pending"
                                    : Model.ApprovalStatus)
                            </span>
                        }

                    </div>

                </div>


                <div class="employer-company-divider"></div>


                <div class="employer-company-details">

                    <div class="employer-detail-item">

                        <div class="employer-detail-icon">
                            <i class="bi bi-envelope-fill"></i>
                        </div>

                        <div>
                            <span>Email Address</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.CompanyEmail)
                                    ? "Not provided"
                                    : Model.CompanyEmail)
                            </strong>
                        </div>

                    </div>


                    <div class="employer-detail-item">

                        <div class="employer-detail-icon employer-detail-purple">
                            <i class="bi bi-telephone-fill"></i>
                        </div>

                        <div>
                            <span>Phone Number</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Phone)
                                    ? "Not provided"
                                    : Model.Phone)
                            </strong>
                        </div>

                    </div>


                    <div class="employer-detail-item">

                        <div class="employer-detail-icon employer-detail-green">
                            <i class="bi bi-globe"></i>
                        </div>

                        <div>
                            <span>Company Website</span>

                            @if (!string.IsNullOrWhiteSpace(Model.Website))
                            {
                                <a href="@Model.Website"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    Visit Website
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                            }
                            else
                            {
                                <strong>Not provided</strong>
                            }

                        </div>

                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(Model.CompanyDescription))
                {
                    <div class="employer-company-description">

                        <div class="employer-description-heading">
                            <i class="bi bi-card-text"></i>
                            About the Company
                        </div>

                        <p>@Model.CompanyDescription</p>

                    </div>
                }

            </section>


            <!-- Approval Notice -->
            @if (Model.ApprovalStatus != "Approved")
            {
                <section class="employer-approval-notice">

                    <div class="employer-approval-notice-icon">
                        @if (Model.ApprovalStatus == "Rejected")
                        {
                            <i class="bi bi-exclamation-circle-fill"></i>
                        }
                        else
                        {
                            <i class="bi bi-hourglass-split"></i>
                        }
                    </div>

                    <div class="employer-approval-notice-content">

                        @if (Model.ApprovalStatus == "Rejected")
                        {
                            <h4>Employer approval was not granted</h4>
                            <p>
                                Your company account is currently marked as rejected.
                                Please review your company details and contact the
                                platform administrator if you need assistance.
                            </p>
                        }
                        else
                        {
                            <h4>Your company profile is awaiting approval</h4>
                            <p>
                                Your company profile must be approved before you can
                                post new jobs. You can continue reviewing and updating
                                your company information while you wait.
                            </p>
                        }

                    </div>

                    <a asp-controller="Employer"
                       asp-action="EditProfile"
                       class="employer-notice-action">
                        View Profile
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </section>
            }


            <!-- Job Management -->
            <div class="employer-section-heading employer-job-heading">

                <div>
                    <h3>Job Management</h3>
                    <p>Manage your job listings and hiring activities.</p>
                </div>

            </div>


            <section class="employer-management-grid">

                <!-- Post Job -->
                <div class="employer-management-card">

                    <div class="employer-management-card-top">

                        <div class="employer-management-icon employer-icon-blue">
                            <i class="bi bi-plus-circle-fill"></i>
                        </div>

                        <span class="employer-management-arrow">
                            <i class="bi bi-arrow-up-right"></i>
                        </span>

                    </div>

                    <h4>Create a New Opportunity</h4>

                    <p>
                        Publish a job listing and let talented candidates
                        discover opportunities at your company.
                    </p>

                    <div class="employer-management-card-footer">

                        @if (Model.ApprovalStatus == "Approved")
                        {
                            <span>Ready to hire?</span>

                            <a asp-controller="Employer"
                               asp-action="CreateJob">
                                Post a Job
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                        else
                        {
                            <span class="employer-footer-pending">
                                Approval required
                            </span>

                            <span class="employer-footer-locked">
                                <i class="bi bi-lock-fill"></i>
                                Posting unavailable
                            </span>
                        }

                    </div>

                </div>


                <!-- Manage Jobs -->
                <div class="employer-management-card">

                    <div class="employer-management-card-top">

                        <div class="employer-management-icon employer-icon-purple">
                            <i class="bi bi-briefcase-fill"></i>
                        </div>

                        <span class="employer-management-arrow">
                            <i class="bi bi-arrow-up-right"></i>
                        </span>

                    </div>

                    <h4>Manage Your Jobs</h4>

                    <p>
                        Review your posted job listings and access
                        applicant management features.
                    </p>

                    <div class="employer-management-card-footer">

                        <span>Hiring workspace</span>

                        <a asp-controller="Employer"
                           asp-action="Jobs">
                            View My Jobs
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>

                </div>


                <!-- Edit Company Profile -->
                <div class="employer-management-card">

                    <div class="employer-management-card-top">

                        <div class="employer-management-icon employer-icon-green">
                            <i class="bi bi-buildings-fill"></i>
                        </div>

                        <span class="employer-management-arrow">
                            <i class="bi bi-arrow-up-right"></i>
                        </span>

                    </div>

                    <h4>Company Profile</h4>

                    <p>
                        Keep your company information, contact details
                        and industry description up to date.
                    </p>

                    <div class="employer-management-card-footer">

                        <span>Company information</span>

                        <a asp-controller="Employer"
                           asp-action="EditProfile">
                            Edit Profile
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>

                </div>

            </section>
        }


        <!-- Footer -->
        <footer class="employer-dashboard-footer">
            <span>FreshStart Employer Workspace</span>
            <span>Connecting companies with future talent.</span>
        </footer>

    </main>

</div>


<style>
    .employer-dashboard {
        display: grid;
        grid-template-columns: 245px minmax(0, 1fr);
        gap: 0;
        max-width: 1600px;
        margin: 8px auto 35px;
        color: #243754;
        background: #f4f7fd;
        border-radius: 2px;
        font-family: inherit;
    }

    .employer-sidebar {
        position: relative;
        display: flex;
        min-width: 0;
        flex-direction: column;
        padding: 27px 19px 22px;
        background: #fff;
        border-right: 1px solid #edf1f7;
    }

    .employer-sidebar-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 34px 3px;
        color: #1f3455;
        font-size: 20px;
        font-weight: 850;
        text-decoration: none;
        letter-spacing: -0.7px;
    }

    .employer-brand-icon {
        display: flex;
        width: 39px;
        height: 39px;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: #3268ef;
        border-radius: 12px;
        font-size: 18px;
        box-shadow: 0 5px 12px rgba(50, 104, 239, 0.16);
    }

    .employer-brand-highlight {
        color: #3268ef;
    }

    .employer-sidebar-label {
        margin: 0 0 12px 12px;
        color: #97a4b8;
        font-size: 9px;
        font-weight: 850;
        letter-spacing: 1.5px;
    }

    .employer-sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .employer-nav-link {
        display: flex;
        min-height: 45px;
        align-items: center;
        gap: 12px;
        padding: 11px 13px;
        color: #64748b;
        background: transparent;
        border: 0;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 600;
        text-align: left;
        text-decoration: none;
        transition: color 0.2s ease, background 0.2s ease;
    }

        .employer-nav-link > i:first-child {
            width: 17px;
            color: #8391a8;
            font-size: 15px;
            text-align: center;
        }

        .employer-nav-link:hover,
        .employer-nav-link.active {
            color: #2864ed;
            background: #edf3ff;
        }

            .employer-nav-link:hover > i:first-child,
            .employer-nav-link.active > i:first-child {
                color: #2864ed;
            }

    .employer-nav-disabled {
        cursor: not-allowed;
        opacity: 0.75;
    }

    .employer-nav-lock {
        margin-left: auto;
        font-size: 11px;
    }

    .employer-sidebar-bottom {
        margin-top: auto;
        padding-top: 45px;
    }

    .employer-sidebar-help {
        padding: 16px 13px;
        background: #f5f8ff;
        border: 1px solid #e7edff;
        border-radius: 13px;
    }

    .employer-help-icon {
        display: flex;
        width: 34px;
        height: 34px;
        align-items: center;
        justify-content: center;
        margin-bottom: 11px;
        color: #3478f6;
        background: #e5edff;
        border-radius: 10px;
        font-size: 16px;
    }

    .employer-sidebar-help h6 {
        margin: 0 0 7px;
        color: #263a57;
        font-size: 12px;
        font-weight: 800;
    }

    .employer-sidebar-help p {
        margin: 0;
        color: #8492a8;
        font-size: 10px;
        line-height: 1.8;
    }

    .employer-sidebar-footer {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 19px 3px 0;
        color: #8492a8;
        font-size: 10px;
    }

    .employer-online-dot {
        width: 7px;
        height: 7px;
        flex-shrink: 0;
        background: #20c878;
        border-radius: 50%;
    }

    .employer-main-content {
        min-width: 0;
        padding: 28px;
        background: #f4f7fd;
    }

    .employer-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 25px;
    }

    .employer-topbar-heading {
        min-width: 0;
    }

    .employer-breadcrumb {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 8px;
        color: #8b9ab0;
        font-size: 10px;
    }

        .employer-breadcrumb i {
            font-size: 9px;
        }

    .employer-topbar-heading h1 {
        margin: 0 0 5px;
        color: #1e3353;
        font-size: clamp(21px, 2vw, 27px);
        font-weight: 850;
        letter-spacing: -0.7px;
    }

    .employer-topbar-heading p {
        margin: 0;
        color: #8492a8;
        font-size: 11px;
        line-height: 1.7;
    }

    .employer-topbar-profile {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        gap: 10px;
        padding: 9px 12px;
        background: #fff;
        border: 1px solid #edf1f7;
        border-radius: 13px;
    }

    .employer-topbar-avatar {
        display: flex;
        width: 38px;
        height: 38px;
        align-items: center;
        justify-content: center;
        color: #3478f6;
        background: #eaf1ff;
        border-radius: 11px;
        font-size: 16px;
    }

    .employer-topbar-info {
        display: flex;
        max-width: 160px;
        flex-direction: column;
        gap: 4px;
    }

        .employer-topbar-info strong {
            overflow: hidden;
            color: #263a57;
            font-size: 10px;
            font-weight: 800;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .employer-topbar-info span {
            color: #8b9ab0;
            font-size: 9px;
        }

    .employer-topbar-shield {
        margin-left: 5px;
        color: #3478f6;
        font-size: 16px;
    }

    .employer-welcome-banner {
        position: relative;
        display: flex;
        min-height: 235px;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 29px;
        padding: 31px 34px;
        overflow: hidden;
        color: #fff;
        background: linear-gradient(115deg, #2454dc 0%, #3478f6 100%);
        border-radius: 18px;
    }

        .employer-welcome-banner::before {
            position: absolute;
            top: -150px;
            right: 95px;
            width: 340px;
            height: 340px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 50%;
            content: "";
        }

        .employer-welcome-banner::after {
            position: absolute;
            right: -120px;
            bottom: -190px;
            width: 370px;
            height: 370px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 50%;
            content: "";
        }

    .employer-welcome-content {
        position: relative;
        z-index: 2;
        max-width: 600px;
    }

    .employer-welcome-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 15px;
        color: #e2ecff;
        font-size: 9px;
        font-weight: 850;
        letter-spacing: 1.4px;
    }

    .employer-welcome-content h2 {
        margin: 0 0 12px;
        color: #fff;
        font-size: clamp(24px, 2.5vw, 32px);
        font-weight: 850;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .employer-welcome-content p {
        max-width: 520px;
        margin: 0 0 20px;
        color: #e6eeff;
        font-size: 12px;
        line-height: 1.9;
    }

    .employer-welcome-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
    }

    .employer-primary-button,
    .employer-secondary-button,
    .employer-approval-button {
        display: inline-flex;
        min-height: 39px;
        align-items: center;
        justify-content: center;
