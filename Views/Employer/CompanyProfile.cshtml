@model FreshStart.Models.Employer.EmployerProfile

@{
    ViewData["Title"] = "Company Profile";
}


<div class="container mt-5">


    <div class="card shadow p-5">


        <div class="text-center">


            @if (!string.IsNullOrEmpty(Model.CompanyLogo))
            {

                <img src="@Model.CompanyLogo"
                     width="150"
                     height="150"
                     class="rounded-circle shadow mb-3" />

            }
            else
            {

                <div class="rounded-circle bg-secondary text-white p-5 d-inline-block">
                    No Logo
                </div>

            }




            <h1 class="fw-bold">
                @Model.CompanyName
            </h1>


            <h5 class="text-muted">
                @Model.Industry
            </h5>


        </div>




        <hr />




        <h3 class="fw-bold mb-3">
            Company Details 🏢
        </h3>




        <div class="row">


            <div class="col-md-6">


                <div class="card bg-light p-3 mb-3">


                    <p>
                        📧 <strong>Email:</strong>
                        @Model.CompanyEmail
                    </p>


                    <p>
                        📞 <strong>Phone:</strong>
                        @Model.Phone
                    </p>


                </div>


            </div>





            <div class="col-md-6">


                <div class="card bg-light p-3 mb-3">


                    <p>
                        🌐 <strong>Website:</strong>
                        @Model.Website
                    </p>


                    <p>
                        🏭 <strong>Industry:</strong>
                        @Model.Industry
                    </p>


                </div>


            </div>


        </div>





        <div class="card shadow-sm p-4 mt-3">


            <h4 class="fw-bold">
                About Company
            </h4>


            <hr />


            <p class="text-muted">

                @Model.CompanyDescription

            </p>


        </div>




    </div>


</div>