```cshtml
@model FreshStart.Models.Employer.EmployerProfile

@{
    ViewData["Title"] = "Company Profile";
}

<div class="company-view-page">

    <!-- Page Header -->
    <div class="company-view-page-header">
        <div>
            <span class="company-view-eyebrow">EMPLOYER PORTAL</span>
            <h1>Company Profile</h1>
            <p>View your organization's information and company details.</p>
        </div>

        <div class="company-view-header-icon">
            <i class="bi bi-buildings"></i>
        </div>
    </div>

    <!-- Company Hero -->
    <div class="company-view-hero">

        <div class="company-view-hero-content">

            <div class="company-view-logo">
                @if (!string.IsNullOrEmpty(Model.CompanyLogo))
                {
                    <img src="@Model.CompanyLogo"
                         alt="@Model.CompanyName logo" />
                }
                else
                {
                    <i class="bi bi-building"></i>
                }
            </div>

            <div class="company-view-identity">
                <span class="company-view-label">
                    COMPANY OVERVIEW
                </span>

                <h2>@Model.CompanyName</h2>

                <div class="company-view-industry">
                    <i class="bi bi-diagram-3"></i>
                    <span>@(string.IsNullOrWhiteSpace(Model.Industry) ? "Industry not specified" : Model.Industry)</span>
                </div>
            </div>

        </div>

        <div class="company-view-hero-decoration">
            <i class="bi bi-buildings"></i>
        </div>

    </div>

    <!-- Company Information -->
    <div class="company-view-section-heading">
        <div class="company-view-section-icon">
            <i class="bi bi-info-circle"></i>
        </div>

        <div>
            <h3>Company Details</h3>
            <p>Your organization's contact information.</p>
        </div>
    </div>

    <div class="company-view-details-grid">

        <!-- Email -->
        <div class="company-view-detail-card">
            <div class="company-view-detail-icon email">
                <i class="bi bi-envelope"></i>
            </div>

            <div class="company-view-detail-content">
                <span>Email Address</span>
                <p>
                    @if (!string.IsNullOrWhiteSpace(Model.CompanyEmail))
                    {
                        <a href="mailto:@Model.CompanyEmail">@Model.CompanyEmail</a>
                    }
                    else
                    {
                        <span class="company-view-empty">Not provided</span>
                    }
                </p>
            </div>
        </div>

        <!-- Phone -->
        <div class="company-view-detail-card">
            <div class="company-view-detail-icon phone">
                <i class="bi bi-telephone"></i>
            </div>

            <div class="company-view-detail-content">
                <span>Phone Number</span>
                <p>
                    @if (!string.IsNullOrWhiteSpace(Model.Phone))
                    {
                        <a href="tel:@Model.Phone">@Model.Phone</a>
                    }
                    else
                    {
                        <span class="company-view-empty">Not provided</span>
                    }
                </p>
            </div>
        </div>

        <!-- Website -->
        <div class="company-view-detail-card">
            <div class="company-view-detail-icon website">
                <i class="bi bi-globe"></i>
            </div>

            <div class="company-view-detail-content">
                <span>Company Website</span>
                <p>
                    @if (!string.IsNullOrWhiteSpace(Model.Website))
                    {
                        <a href="@Model.Website"
                           target="_blank"
                           rel="noopener noreferrer">@Model.Website</a>
                    }
                    else
                    {
                        <span class="company-view-empty">Not provided</span>
                    }
                </p>
            </div>
        </div>

        <!-- Industry -->
        <div class="company-view-detail-card">
            <div class="company-view-detail-icon industry">
                <i class="bi bi-diagram-3"></i>
            </div>

            <div class="company-view-detail-content">
                <span>Industry</span>
                <p>
                    @(string.IsNullOrWhiteSpace(Model.Industry) ? "Not specified" : Model.Industry)
                </p>
            </div>
        </div>

    </div>

    <!-- About Company -->
    <div class="company-view-about-card">

        <div class="company-view-about-heading">
            <div class="company-view-section-icon">
                <i class="bi bi-buildings"></i>
            </div>

            <div>
                <h3>About the Company</h3>
                <p>Learn more about the organization.</p>
            </div>
        </div>

        <div class="company-view-description">
            @if (!string.IsNullOrWhiteSpace(Model.CompanyDescription))
            {
                @Model.CompanyDescription
            }
            else
            {
                <span class="company-view-empty">
                    No company description has been added yet.
                </span>
            }
        </div>

    </div>

    <!-- Bottom Note -->
    <div class="company-view-footer-note">
        <div class="company-view-footer-icon">
            <i class="bi bi-lightbulb"></i>
        </div>

        <div>
            <h5>Keep Your Company Information Updated</h5>
            <p>
                Accurate contact details and a clear company description
                help students learn more about your organization.
            </p>
        </div>
    </div>

</div>

<style>
    .company-view-page {
        max-width: 1200px;
        margin: 35px auto;
        padding: 0 18px 40px;
        color: #172b4d;
    }

    .company-view-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 27px;
    }

    .company-view-eyebrow {
        display: block;
        margin-bottom: 8px;
        color: #3478dc;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.5px;
    }

    .company-view-page-header h1 {
        margin: 0 0 8px;
        font-size: 29px;
        font-weight: 800;
        letter-spacing: -0.7px;
    }

    .company-view-page-header p {
        margin: 0;
        color: #75839a;
        font-size: 13px;
        line-height: 1.7;
    }

    .company-view-header-icon {
        width: 57px;
        height: 57px;
        min-width: 57px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        background: #eaf1ff;
        color: #2563eb;
        font-size: 25px;
    }

    .company-view-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        min-height: 220px;
        margin-bottom: 32px;
        padding: 35px;
        overflow: hidden;
        border: 1px solid #dce8fc;
        border-radius: 23px;
        background: linear-gradient(120deg, #edf4ff 0%, #f8faff 65%, #e8f0ff 100%);
    }

    .company-view-hero-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 27px;
        min-width: 0;
    }

    .company-view-logo {
        width: 125px;
        height: 125px;
        min-width: 125px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 4px solid #fff;
        border-radius: 25px;
        background: #fff;
        color: #3478dc;
        font-size: 49px;
        box-shadow: 0 8px 24px rgba(38, 73, 130, 0.1);
    }

        .company-view-logo img {
            width: 100%;
            height: 100%;
            padding: 7px;
            object-fit: contain;
            background: #fff;
        }

    .company-view-identity {
        min-width: 0;
    }

    .company-view-label {
        display: inline-block;
        margin-bottom: 10px;
        color: #3478dc;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.2px;
    }

    .company-view-identity h2 {
        margin: 0 0 13px;
        color: #20385f;
        font-size: 30px;
        font-weight: 800;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .company-view-industry {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 9px 13px;
        border: 1px solid #dce7fa;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.8);
        color: #5b7193;
        font-size: 12px;
    }

        .company-view-industry i {
            color: #3478dc;
            font-size: 15px;
        }

    .company-view-hero-decoration {
        position: absolute;
        right: -16px;
        bottom: -54px;
        color: rgba(52, 120, 220, 0.055);
        font-size: 230px;
        line-height: 1;
        pointer-events: none;
    }

    .company-view-section-heading,
    .company-view-about-heading {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .company-view-section-heading {
        margin-bottom: 21px;
    }

    .company-view-section-icon {
        width: 44px;
        height: 44px;
        min-width: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #edf4ff;
        color: #2563eb;
        font-size: 20px;
    }

    .company-view-section-heading h3,
    .company-view-about-heading h3 {
        margin: 0 0 5px;
        color: #203452;
        font-size: 17px;
        font-weight: 750;
    }

    .company-view-section-heading p,
    .company-view-about-heading p {
        margin: 0;
        color: #8995a8;
        font-size: 12px;
        line-height: 1.6;
    }

    .company-view-details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 28px;
    }

    .company-view-detail-card {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        min-width: 0;
        padding: 23px;
        border: 1px solid #e8edf5;
        border-radius: 17px;
        background: #fff;
        box-shadow: 0 6px 23px rgba(27, 55, 100, 0.035);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .company-view-detail-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 27px rgba(27, 55, 100, 0.07);
        }

    .company-view-detail-icon {
        width: 47px;
        height: 47px;
        min-width: 47px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 20px;
    }

        .company-view-detail-icon.email {
            background: #edf4ff;
            color: #3478dc;
        }

        .company-view-detail-icon.phone {
            background: #e9f8f0;
            color: #24865b;
        }

        .company-view-detail-icon.website {
            background: #f2edff;
            color: #7853c5;
        }

        .company-view-detail-icon.industry {
            background: #fff4e6;
            color: #c27a22;
        }

    .company-view-detail-content {
        min-width: 0;
        padding-top: 2px;
    }

        .company-view-detail-content > span {
            display: block;
            margin-bottom: 8px;
            color: #8995a8;
            font-size: 11px;
            font-weight: 650;
        }

        .company-view-detail-content p {
            margin: 0;
            color: #293d5a;
            font-size: 13px;
            font-weight: 650;
            line-height: 1.7;
            overflow-wrap: anywhere;
        }

        .company-view-detail-content a {
            color: #293d5a;
            text-decoration: none;
            overflow-wrap: anywhere;
        }

            .company-view-detail-content a:hover {
                color: #2563eb;
                text-decoration: underline;
            }

    .company-view-empty {
        color: #9aa5b5;
        font-weight: 400;
        font-style: italic;
    }

    .company-view-about-card {
        padding: 28px;
        border: 1px solid #e8edf5;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 8px 28px rgba(27, 55, 100, 0.045);
    }

    .company-view-about-heading {
        padding-bottom: 21px;
        border-bottom: 1px solid #edf0f6;
    }

    .company-view-description {
        padding-top: 21px;
        color: #61718a;
        font-size: 13px;
        line-height: 2;
        overflow-wrap: anywhere;
        white-space: pre-line;
    }

    .company-view-footer-note {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        margin-top: 25px;
        padding: 22px;
        border: 1px solid #dce8fc;
        border-radius: 16px;
        background: #f4f8ff;
    }

    .company-view-footer-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #fff;
        color: #3478dc;
        font-size: 20px;
    }

    .company-view-footer-note h5 {
        margin: 0 0 6px;
        color: #304b72;
        font-size: 13px;
        font-weight: 750;
    }

    .company-view-footer-note p {
        margin: 0;
        color: #7184a0;
        font-size: 12px;
        line-height: 1.8;
    }

    @@media (max-width: 700px) {
        .company-view-page {
            margin-top: 22px;
            padding: 0 12px 25px;
        }

        .company-view-page-header h1 {
