            bottom: -20px;
            font-size: 145px;
        }

        .company-view-details-grid {
            grid-template-columns: 1fr;
            gap: 13px;
        }

        .company-view-detail-card {
            padding: 19px;
        }

        .company-view-about-card {
            padding: 21px 17px;
        }
    }
</style>
