            border-radius: 18px;
        }

        .company-view-hero-content {
            align-items: flex-start;
            flex-direction: column;
            gap: 18px;
        }

        .company-view-logo {
            width: 92px;
            height: 92px;
            min-width: 92px;
            border-radius: 19px;
            font-size: 36px;
        }

        .company-view-identity h2 {
            font-size: 24px;
        }

        .company-view-hero-decoration {
