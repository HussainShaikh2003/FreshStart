@model IEnumerable<FreshStart.Models.Job.Job>

@{
    ViewData["Title"] = "My Jobs";
}


<div class="container mt-5">


    <div class="d-flex justify-content-between align-items-center mb-4">


        <h2>
            My Posted Jobs
        </h2>


        <a asp-controller="Employer"
           asp-action="CreateJob"
           class="btn btn-primary">

            Post New Job

        </a>


    </div>





    <div class="card shadow p-4">


        <table class="table table-bordered table-striped">


            <thead>

                <tr>

                    <th>
                        Job Title
                    </th>

                    <th>
                        Skills
                    </th>

                    <th>
                        Location
                    </th>

                    <th>
                        Salary
                    </th>

                    <th>
                        Type
                    </th>

                    <th>
                        Deadline
                    </th>

                </tr>

            </thead>



            <tbody>


                @foreach (var job in Model)
                {

                    <tr>


                        <td>
                            @job.JobTitle
                        </td>


                        <td>
                            @job.RequiredSkills
                        </td>


                        <td>
                            @job.Location
                        </td>


                        <td>
                            @job.Salary
                        </td>


                        <td>
                            @job.JobType
                        </td>


                        <td>
                            @job.Deadline.ToShortDateString()
                        </td>


                    </tr>

                }


            </tbody>


        </table>


    </div>


</div>