@model IEnumerable<FreshStart.Models.Job.Job>

@{
    ViewData["Title"] = "My Jobs";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">
            My Posted Jobs 💼
        </h1>

        <a asp-controller="Employer"
           asp-action="CreateJob"
           class="btn btn-primary">
            ➕ Post New Job
        </a>
    </div>

    <div class="card shadow p-4">
        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Job Title</th>
                        <th>Skills</th>
                        <th>Location</th>
                        <th>Salary Range</th>
                        <th>Type</th>
                        <th>Deadline</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var job in Model)
                    {
                        <tr>
                            <td>
                                <strong>@job.JobTitle</strong>
                            </td>

                            <td>
                                <span class="badge bg-primary">
                                    @job.RequiredSkills
                                </span>
                            </td>

                            <td>
                                📍 @job.Location
                            </td>

                            <td>
                                💰 @job.MinimumSalary.ToString("N0")
                                – @job.MaximumSalary.ToString("N0")
                                / @job.SalaryType
                            </td>

                            <td>@job.JobType</td>

                            <td>@job.Deadline.ToShortDateString()</td>

                            <td>
                                <a asp-controller="Employer"
                                   asp-action="Applicants"
                                   asp-route-id="@job.JobId"
                                   class="btn btn-info btn-sm">
                                    View Applicants
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>
